# Copy to tests/genx-e2e/.env for local genx provider e2e runs.
# Keep this file credential-only. Test models, voices, audio formats, and
# fixtures are embedded or hardcoded by the tests.

GIZCLAW_GENX_E2E_DOUBAO_APP_ID=
GIZCLAW_GENX_E2E_DOUBAO_API_KEY=

# DashScope credential used by the Realtime ToolInvoker continuation e2e test.
GIZCLAW_GENX_E2E_DASHSCOPE_API_KEY=

GIZCLAW_GENX_E2E_MINIMAX_API_KEY=
GIZCLAW_GENX_E2E_MINIMAX_BASE_URL=https://api.minimax.io
GIZCLAW_GENX_E2E_MINIMAX_VOICE_ID=female-shaonv

# OpenAI-compatible config used by the Match chat e2e Flowcraft path.
GIZCLAW_GENX_E2E_FLOWCRAFT_OPENAI_API_KEY=
GIZCLAW_GENX_E2E_FLOWCRAFT_OPENAI_BASE_URL=https://api.openai.com/v1
GIZCLAW_GENX_E2E_FLOWCRAFT_OPENAI_MODEL=gpt-4o-mini

# OpenAI-compatible config used by the Match chat e2e Eino path.
GIZCLAW_GENX_E2E_EINO_OPENAI_API_KEY=
GIZCLAW_GENX_E2E_EINO_OPENAI_BASE_URL=https://api.openai.com/v1
GIZCLAW_GENX_E2E_EINO_OPENAI_MODEL=gpt-4o-mini
