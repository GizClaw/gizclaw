ARG BASE_IMAGE=gizclaw-go:linux-amd64-cn-base
FROM ${BASE_IMAGE}

WORKDIR /src

RUN apt-get update \
 && apt-get install -y --no-install-recommends gettext-base python3 \
 && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY sdk/js/package.json sdk/js/package.json
COPY sdk/js/gizclaw/package.json sdk/js/gizclaw/package.json
COPY sdk/js/gizclaw-control/package.json sdk/js/gizclaw-control/package.json
COPY web/console/package.json web/console/package.json

RUN npm ci

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN npm run build:console
RUN find tests/gizclaw-e2e/docker -name '*.sh' -exec chmod +x {} +

# Admission starts three copies of the CLI on small CI runners. Build it once
# in the image, before any container health or fixture-readiness checks begin.
ARG PREBUILD_CLI=0
RUN if [ "$PREBUILD_CLI" = "1" ]; then tests/gizclaw-e2e/docker/setup/build.sh; fi
ENV GIZCLAW_E2E_PREBUILT_CLI=${PREBUILD_CLI}

ENTRYPOINT ["/src/tests/gizclaw-e2e/docker/entrypoint-server.sh"]
