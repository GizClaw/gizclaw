        {
          "id": "echo",
          "type": "script",
          "publish": true,
          "config": {
            "source": "host.emit(\"token\", {content: \"开场【狐】狐狸说话【鸟】小鸟回答【狐】狐狸再说【路人】尾声\"});"
          }
        }
      ],
      "edges": [
        {
          "from": "echo",
          "to": "__end__"
        }
      ]
    }
  }
}
