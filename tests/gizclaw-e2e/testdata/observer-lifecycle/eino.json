{
  "driver": "eino",
  "eino": {
    "voice_adapter": {
      "asr_model": "asr",
      "default_voice": "narrator"
    },
    "graph": {
      "name": "lifecycle",
      "compile": {
        "node_trigger_mode": "any_predecessor"
      },
      "state": {
        "fields": [
          {
            "name": "messages",
            "type": "messages",
            "merge": "replace"
          },
          {
            "name": "answer",
            "type": "string",
            "merge": "replace"
          }
        ]
      },
      "nodes": [
        {
          "id": "prompt",
          "type": "prompt",
          "inputs": {
            "text": {
              "from": "input.text"
            }
          },
          "outputs": {
            "messages": "messages"
          },
          "format": "f_string",
          "messages": [
            {
              "role": "user",
              "template": "{text}"
            }
          ]
        },
        {
          "id": "model",
          "type": "chat_model",
          "model": "llm",
          "inputs": {
            "messages": {
              "from": "messages"
            }
          },
          "outputs": {
            "text": "answer"
          }
        }
      ],
      "edges": [
        {
          "from": "start",
          "to": "prompt"
        },
        {
          "from": "prompt",
          "to": "model"
        },
        {
          "from": "model",
          "to": "end"
        }
      ],
      "branches": [],
      "outputs": [
        {
          "node": "model",
          "field": "answer",
          "name": "assistant",
          "mime_type": "text/plain",
          "primary": true
        }
      ]
    }
  }
}
