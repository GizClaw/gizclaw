{
  "agent": "flowcraft",
  "models": {
    "asr": "asr",
    "llm": "llm",
    "tts": "tts"
  },
  "persona": "You are a deterministic latency benchmark client.",
  "rounds": 1,
  "timeout": "1200s",
  "utterances": [
    "请报告当前系统状态"
  ],
  "voice": "assistant-voice",
  "workflow": {
    "description": "Flowcraft side of the matched complex workflow latency comparison",
    "flowcraft": {
      "conversation": {
        "starts": "peer"
      },
      "graph": {
        "edges": [
          {
            "from": "recall-memory",
            "to": "capture-input"
          },
          {
            "from": "capture-input",
            "to": "planner-prompt"
          },
          {
            "from": "planner-prompt",
            "to": "planner-model"
          },
          {
            "from": "planner-model",
            "to": "answer-prompt"
          },
          {
            "from": "answer-prompt",
            "to": "answer-model"
          },
          {
            "from": "answer-model",
            "to": "observe-turn"
          },
          {
            "from": "observe-turn",
            "to": "completion-barrier"
          },
          {
            "from": "completion-barrier",
            "to": "__end__"
          }
        ],
        "entry": "recall-memory",
        "name": "Complex Workflow Latency Comparison",
        "nodes": [
          {
            "config": {
              "output": "recalled-memory",
              "query": {
                "text_from": "input"
              },
              "top_k": 5
            },
            "id": "recall-memory",
            "type": "memory_recall"
          },
          {
            "config": {
              "runtime": "js",
              "source": "const messages = board.channel(board.MAIN_CHANNEL) || [];\nlet inputText = \"\";\nfor (let i = messages.length - 1; i \u003e= 0; i--) {\n  const message = messages[i] || {};\n  if (message.role !== \"user\") continue;\n  if (typeof message.content === \"string\" \u0026\u0026 message.content.trim()) {\n    inputText = message.content.trim();\n    break;\n  }\n  const parts = message.content \u0026\u0026 Array.isArray(message.content.parts) ? message.content.parts : [];\n  inputText = parts.map(function(part) {\n    return part \u0026\u0026 part.type === \"text\" \u0026\u0026 typeof part.text === \"string\" ? part.text : \"\";\n  }).join(\"\").trim();\n  if (inputText) break;\n}\nboard.setVar(\"captured-input\", inputText);\n"
            },
            "id": "capture-input",
            "type": "script"
          },
          {
            "config": {
              "runtime": "js",
              "source": "board.setChannel(\"planner-messages\", [{\n  role: \"user\",\n  content: { parts: [{ type: \"text\", text: board.getVar(\"captured-input\") || \"\" }] }\n}]);\n"
            },
            "id": "planner-prompt",
            "type": "script"
          },
          {
            "config": {
              "intent": {
                "text": {
                  "max_output_tokens": 64,
                  "temperature": 0
                }
              },
              "messages_channel": "planner-messages",
              "model": {
                "id": {
                  "name": "llm",
                  "provider": "gizclaw"
                }
              },
              "output_key": "plan",
              "stream": true,
              "system_prompt": "请把用户请求归纳成一个不超过二十个汉字的执行计划。只输出计划，不要解释。"
            },
            "id": "planner-model",
            "publish": false,
            "type": "inference"
          },
          {
            "config": {
              "runtime": "js",
              "source": "const memory = board.getVar(\"recalled-memory\") || \"\";\nconst plan = board.getVar(\"plan\") || \"\";\nboard.setVar(\"answer-system-prompt\", [\n  \"你是一个简短、准确的中文语音助手。\",\n  \"请参考下面的长期记忆和执行计划回答用户；长期记忆为空时忽略。\",\n  \"长期记忆：\\n\" + memory,\n  \"执行计划：\\n\" + plan,\n  \"回答只说一句简短中文，不要提及计划或记忆。\"\n].join(\"\\n\"));\nboard.setChannel(\"answer-messages\", [{\n  role: \"user\",\n  content: { parts: [{ type: \"text\", text: board.getVar(\"captured-input\") || \"\" }] }\n}]);\n"
            },
            "id": "answer-prompt",
            "type": "script"
          },
          {
            "config": {
              "intent": {
                "text": {
                  "max_output_tokens": 128,
                  "temperature": 0
                }
              },
              "messages_channel": "answer-messages",
              "model": {
                "id": {
                  "name": "llm",
                  "provider": "gizclaw"
                }
              },
              "output_key": "answer",
              "stream": true,
              "system_prompt": "${board:answer-system-prompt}"
            },
            "id": "answer-model",
            "publish": true,
            "type": "inference"
          },
          {
            "config": {
              "observations": [
                {
                  "facts": [
                    {
                      "text_from": "captured-input"
                    },
                    {
                      "text_from": "answer"
                    }
                  ]
                }
              ],
              "wait_for_completion": true
            },
            "id": "observe-turn",
            "type": "memory_observe"
          },
          {
            "id": "completion-barrier",
            "type": "passthrough"
          }
        ]
      },
      "max_iterations": 10
    },
    "memory": "default-memory",
    "name": "flowcraft-latency-comparison",
    "parameters": {
      "input": "push-to-talk"
    },
    "voice_adapter": {
      "asr_model": "asr",
      "default_voice": "assistant-voice",
      "node_voices": {
        "answer-model": "assistant-voice"
      }
    }
  }
}
