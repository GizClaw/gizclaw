{
  "agent": "eino",
  "models": {
    "asr": "asr",
    "llm": "llm",
    "tts": "tts"
  },
  "persona": "Use short Chinese hint-seeking utterances that keep the poetry adventure on the retry path.",
  "rounds": 3,
  "timeout": "1200s",
  "utterances": [
    "我还没想好诗句",
    "请再给我一点提示",
    "我还需要更多线索"
  ],
  "voice": "assistant-voice",
  "workflow": {
    "eino": {
      "graph": {
        "name": "eino-poetry-adventure-li-bai",
        "compile": {
          "node_trigger_mode": "any_predecessor",
          "primary_output_mode": "first_output"
        },
        "state": {
          "fields": [
            {
              "name": "game",
              "type": "object",
              "merge": "replace"
            },
            {
              "name": "context",
              "type": "string",
              "merge": "replace"
            },
            {
              "name": "private",
              "type": "string",
              "merge": "replace"
            },
            {
              "name": "feedback",
              "type": "string",
              "merge": "replace"
            },
            {
              "name": "valid",
              "type": "boolean",
              "merge": "replace"
            },
            {
              "name": "recalled-memory",
              "type": "string",
              "merge": "replace"
            },
            {
              "name": "messages",
              "type": "messages",
              "merge": "replace"
            },
            {
              "name": "answer",
              "type": "string",
              "merge": "replace"
            },
            {
              "name": "rejected",
              "type": "string",
              "merge": "replace"
            }
          ]
        },
        "nodes": [
          {
            "id": "rules",
            "type": "script",
            "language": "starlark",
            "entrypoint": "run",
            "source": "def run(input):\n    game = json.decode(json.encode(input[\"game\"]))\n    if not game or \"重新开始\" in input[\"text\"]:\n        game = {\"stage\": 0, \"cleared\": [], \"score\": 0, \"attempts\": 0}\n    stages = [\n        {\"era\": \"唐\", \"badge\": \"唐月徽章\", \"challenge\": \"请说一句带月亮意象的唐诗\", \"answers\": [\"床前明月光\", \"举头望明月\", \"明月出天山\", \"我寄愁心与明月\"]},\n        {\"era\": \"宋\", \"badge\": \"宋河徽章\", \"challenge\": \"请说一句宋代诗词里写江河湖水或浪涛的句子\", \"answers\": [\"大江东去浪淘尽\", \"水光潋滟晴方好\", \"竹外桃花三两枝\"]},\n        {\"era\": \"元\", \"badge\": \"元暮徽章\", \"challenge\": \"请说一句《天净沙·秋思》中的句子\", \"answers\": [\"枯藤老树昏鸦\", \"小桥流水人家\", \"古道西风瘦马\", \"夕阳西下\"]},\n        {\"era\": \"明\", \"badge\": \"明勇徽章\", \"challenge\": \"请说一句于谦《石灰吟》中的句子\", \"answers\": [\"千锤万凿出深山\", \"粉骨碎身浑不怕\", \"要留清白在人间\"]},\n    ]\n    stage = game[\"stage\"]\n    # Normalize punctuation/spacing, then accept only the deterministic catalogue.\n    text = input[\"text\"]\n    for punctuation in [\" \", \"，\", \"。\", \"！\", \"？\", \"、\", \"；\", \"：\"]:\n        text = text.replace(punctuation, \"\")\n    if stage < len(stages):\n        game[\"attempts\"] += 1\n        if any([answer in text for answer in stages[stage][\"answers\"]]):\n            game[\"cleared\"].append(stages[stage][\"badge\"])\n            game[\"score\"] += 100\n            game[\"stage\"] += 1\n    stage = game[\"stage\"]\n    context = {\"cleared\": game[\"cleared\"], \"score\": game[\"score\"], \"finished\": stage == len(stages)}\n    if stage < len(stages):\n        context[\"era\"] = stages[stage][\"era\"]\n        context[\"challenge\"] = stages[stage][\"challenge\"]\n    return {\"game\": game, \"context\": json.encode(context), \"feedback\": \"\", \"valid\": True, \"private\": \"\"}\n",
            "limits": {
              "max_execution_steps": 100000,
              "timeout": "1s",
              "max_input_bytes": 1048576,
              "max_output_bytes": 1048576
            },
            "inputs": {
              "game": {
                "from": "game"
              },
              "text": {
                "from": "input.text"
              }
            },
            "outputs": {
              "game": "game",
              "context": "context",
              "private": "private",
              "feedback": "feedback",
              "valid": "valid"
            }
          },
          {
            "id": "reject",
            "type": "passthrough",
            "inputs": {
              "value": {
                "from": "feedback"
              }
            },
            "outputs": {
              "value": "rejected"
            }
          },
          {
            "id": "recall",
            "type": "memory_recall",
            "query_from": "input.text",
            "output": "recalled-memory",
            "top_k": 5
          },
          {
            "id": "prompt",
            "type": "prompt",
            "format": "f_string",
            "inputs": {
              "context": {
                "from": "context"
              },
              "player": {
                "from": "private"
              },
              "memory": {
                "from": "recalled-memory"
              },
              "safety": {
                "from": "input.safety_fence"
              },
              "history": {
                "from": "input.messages"
              }
            },
            "outputs": {
              "messages": "messages"
            },
            "messages": [
              {
                "role": "system",
                "template": "你扮演李白陪用户穿越唐宋元明。依据当前 era 和 challenge 提问；只有状态中的 cleared 才算通关。错误时给提示，不替用户回答。finished 为 true 后庆祝并自由交流诗词。\n\n当前规则状态（这是权威结果，不得修改或另行判定）：\n{context}\n玩家自己的私密信息：{player}\n长期记忆：{memory}\n{safety}"
              },
              {
                "placeholder": "history",
                "optional": true
              }
            ]
          },
          {
            "id": "host",
            "type": "chat_model",
            "model": "llm",
            "max_tokens": 2048,
            "inputs": {
              "messages": {
                "from": "messages"
              }
            },
            "outputs": {
              "text": "answer"
            }
          },
          {
            "id": "remember",
            "type": "memory_observe",
            "text_from": "context",
            "wait_for_completion": true
          }
        ],
        "edges": [
          {
            "from": "start",
            "to": "rules"
          },
          {
            "from": "reject",
            "to": "end"
          },
          {
            "from": "recall",
            "to": "prompt"
          },
          {
            "from": "prompt",
            "to": "host"
          },
          {
            "from": "host",
            "to": "remember"
          },
          {
            "from": "remember",
            "to": "end"
          }
        ],
        "branches": [
          {
            "from": "rules",
            "mode": "first_match",
            "routes": [
              {
                "when": {
                  "field": "valid",
                  "op": "eq",
                  "value": false
                },
                "to": "reject"
              }
            ],
            "default": "recall"
          }
        ],
        "outputs": [
          {
            "node": "host",
            "field": "answer",
            "name": "assistant",
            "mime_type": "text/plain",
            "primary": true
          },
          {
            "node": "reject",
            "field": "rejected",
            "name": "rejected",
            "mime_type": "text/plain"
          }
        ]
      },
      "state_persistence": {
        "fields": [
          "game"
        ]
      },
      "conversation": {
        "starts": "peer"
      },
      "voice_adapter": {
        "asr_model": "asr",
        "default_voice": "narrator",
        "node_voices": {
          "host": "narrator",
          "reject": "narrator"
        }
      }
    },
    "name": "eino-poetry-adventure-li-bai",
    "parameters": {},
    "memory": "poetry-memory",
    "description": "Eino raid: Poetry Adventure Li Bai"
  }
}
