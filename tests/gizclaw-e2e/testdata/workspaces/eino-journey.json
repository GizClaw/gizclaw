{
  "agent": "eino",
  "models": {
    "asr": "asr",
    "llm": "llm",
    "tts": "tts"
  },
  "persona": "Always generate exactly this Chinese utterance: 继续讲西游记，讲短一点。",
  "rounds": 3,
  "timeout": "1200s",
  "voice": "assistant-voice",
  "workflow": {
    "eino": {
      "graph": {
        "name": "eino-journey-guide",
        "compile": {
          "node_trigger_mode": "any_predecessor",
          "primary_output_mode": "first_output"
        },
        "state": {
          "fields": [
            {
              "name": "game",
              "type": "object",
              "merge": "replace"
            },
            {
              "name": "context",
              "type": "string",
              "merge": "replace"
            },
            {
              "name": "private",
              "type": "string",
              "merge": "replace"
            },
            {
              "name": "feedback",
              "type": "string",
              "merge": "replace"
            },
            {
              "name": "valid",
              "type": "boolean",
              "merge": "replace"
            },
            {
              "name": "recalled-memory",
              "type": "string",
              "merge": "replace"
            },
            {
              "name": "messages",
              "type": "messages",
              "merge": "replace"
            },
            {
              "name": "answer",
              "type": "string",
              "merge": "replace"
            },
            {
              "name": "rejected",
              "type": "string",
              "merge": "replace"
            }
          ]
        },
        "nodes": [
          {
            "id": "rules",
            "type": "script",
            "language": "starlark",
            "entrypoint": "run",
            "source": "def run(input):\n    game = json.decode(json.encode(input[\"game\"]))\n    if not game:\n        game = {\"chapter\": 0, \"setting\": \"花果山\", \"progress\": 0}\n    places = [\"花果山\", \"天宫\", \"启程\", \"三国\", \"试炼\", \"取经\"]\n    for index, place in enumerate(places):\n        if place in input[\"text\"]:\n            game[\"setting\"] = place\n            game[\"chapter\"] = index\n    if \"继续\" in input[\"text\"] or \"下一章\" in input[\"text\"]:\n        game[\"progress\"] += 1\n        game[\"chapter\"] = min(game[\"chapter\"] + 1, len(places) - 1)\n        game[\"setting\"] = places[game[\"chapter\"]]\n    return {\"game\": game, \"context\": json.encode(game), \"feedback\": \"\", \"valid\": True, \"private\": \"\"}\n",
            "limits": {
              "max_execution_steps": 100000,
              "timeout": "1s",
              "max_input_bytes": 1048576,
              "max_output_bytes": 1048576
            },
            "inputs": {
              "game": {
                "from": "game"
              },
              "text": {
                "from": "input.text"
              }
            },
            "outputs": {
              "game": "game",
              "context": "context",
              "private": "private",
              "feedback": "feedback",
              "valid": "valid"
            }
          },
          {
            "id": "reject",
            "type": "passthrough",
            "inputs": {
              "value": {
                "from": "feedback"
              }
            },
            "outputs": {
              "value": "rejected"
            }
          },
          {
            "id": "recall",
            "type": "memory_recall",
            "query_from": "input.text",
            "output": "recalled-memory",
            "top_k": 5
          },
          {
            "id": "prompt",
            "type": "prompt",
            "format": "f_string",
            "inputs": {
              "context": {
                "from": "context"
              },
              "player": {
                "from": "private"
              },
              "memory": {
                "from": "recalled-memory"
              },
              "safety": {
                "from": "input.safety_fence"
              },
              "history": {
                "from": "input.messages"
              }
            },
            "outputs": {
              "messages": "messages"
            },
            "messages": [
              {
                "role": "system",
                "template": "你是西游冒险故事主持人。依据当前章节和场景接续故事，回应用户选择，使用简短生动的中文；角色对白可使用【悟空】【唐僧】【八戒】【妖怪】标记。\n\n当前规则状态（这是权威结果，不得修改或另行判定）：\n{context}\n玩家自己的私密信息：{player}\n长期记忆：{memory}\n{safety}"
              },
              {
                "placeholder": "history",
                "optional": true
              }
            ]
          },
          {
            "id": "host",
            "type": "chat_model",
            "model": "llm",
            "max_tokens": 2048,
            "inputs": {
              "messages": {
                "from": "messages"
              }
            },
            "outputs": {
              "text": "answer"
            }
          },
          {
            "id": "remember",
            "type": "memory_observe",
            "text_from": "context",
            "wait_for_completion": true
          }
        ],
        "edges": [
          {
            "from": "start",
            "to": "rules"
          },
          {
            "from": "reject",
            "to": "end"
          },
          {
            "from": "recall",
            "to": "prompt"
          },
          {
            "from": "prompt",
            "to": "host"
          },
          {
            "from": "host",
            "to": "remember"
          },
          {
            "from": "remember",
            "to": "end"
          }
        ],
        "branches": [
          {
            "from": "rules",
            "mode": "first_match",
            "routes": [
              {
                "when": {
                  "field": "valid",
                  "op": "eq",
                  "value": false
                },
                "to": "reject"
              }
            ],
            "default": "recall"
          }
        ],
        "outputs": [
          {
            "node": "host",
            "field": "answer",
            "name": "assistant",
            "mime_type": "text/plain",
            "primary": true
          },
          {
            "node": "reject",
            "field": "rejected",
            "name": "rejected",
            "mime_type": "text/plain"
          }
        ]
      },
      "state_persistence": {
        "fields": [
          "game"
        ]
      },
      "conversation": {
        "starts": "peer"
      },
      "voice_adapter": {
        "asr_model": "asr",
        "default_voice": "narrator",
        "node_voices": {
          "host": "narrator",
          "reject": "narrator"
        },
        "speaker_voices": {
          "悟空": "sun-wukong",
          "唐僧": "tang-sanzang",
          "八戒": "zhu-bajie",
          "妖怪": "monster"
        }
      }
    },
    "name": "eino-journey-guide",
    "parameters": {
      "input": "push-to-talk"
    },
    "memory": "journey-memory",
    "description": "Eino raid: Journey"
  }
}
