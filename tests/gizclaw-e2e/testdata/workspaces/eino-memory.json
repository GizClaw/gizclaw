{
  "agent": "eino",
  "models": {
    "llm": "llm",
    "tts": "tts",
    "asr": "asr"
  },
  "workflow": {
    "name": "eino-memory-assistant",
    "description": "Eino prompt and chat model workflow with configured memory",
    "eino": {
      "graph": {
        "name": "eino-memory-assistant",
        "compile": {
          "node_trigger_mode": "any_predecessor",
          "max_run_steps": 16
        },
        "state": {
          "fields": [
            {
              "name": "recalled",
              "type": "string",
              "merge": "replace"
            },
            {
              "name": "messages",
              "type": "messages",
              "merge": "replace"
            },
            {
              "name": "answer",
              "type": "string",
              "merge": "replace"
            }
          ]
        },
        "nodes": [
          {
            "id": "prompt",
            "type": "prompt",
            "inputs": {
              "text": {
                "from": "input.text"
              },
              "memory": {
                "from": "recalled"
              }
            },
            "outputs": {
              "messages": "messages"
            },
            "format": "f_string",
            "messages": [
              {
                "role": "system",
                "template": "你是一个简短、准确的中文助手。\n相关长期记忆如下；如果为空就忽略：\n{memory}\n"
              },
              {
                "role": "user",
                "template": "{text}"
              }
            ]
          },
          {
            "id": "model",
            "type": "chat_model",
            "inputs": {
              "messages": {
                "from": "messages"
              }
            },
            "outputs": {
              "text": "answer"
            },
            "model": "llm",
            "max_tokens": 256
          }
        ],
        "edges": [
          {
            "from": "start",
            "to": "prompt"
          },
          {
            "from": "prompt",
            "to": "model"
          },
          {
            "from": "model",
            "to": "end"
          }
        ],
        "branches": [],
        "outputs": [
          {
            "node": "model",
            "field": "answer",
            "name": "assistant",
            "mime_type": "text/plain",
            "primary": true
          }
        ]
      },
      "memory": {
        "recall": [
          {
            "query_from": "input.text",
            "output": "recalled",
            "top_k": 5
          }
        ],
        "observe": {
          "enabled": true,
          "wait_for_completion": true
        }
      }
    }
  },
  "voice": "assistant-voice",
  "rounds": 1,
  "timeout": "300s",
  "persona": "You are a concise Chinese chat test user."
}
