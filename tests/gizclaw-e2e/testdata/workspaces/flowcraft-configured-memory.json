{
  "agent": "flowcraft",
  "models": {
    "asr": "asr",
    "llm": "llm",
    "tts": "tts"
  },
  "persona": "You are a concise Chinese voice chat test user. Keep every utterance short and speech friendly.",
  "rounds": 1,
  "timeout": "300s",
  "voice": "assistant-voice",
  "workflow": {
    "description": "Flowcraft workflow using the configured provider-neutral memory store",
    "flowcraft": {
      "conversation": {
        "starts": "peer"
      },
      "graph": {
        "edges": [
          {
            "from": "answer",
            "to": "__end__"
          }
        ],
        "entry": "answer",
        "name": "Configured Memory Assistant",
        "nodes": [
          {
            "config": {
              "intent": {
                "text": {
                  "max_output_tokens": 2048
                }
              },
              "messages_channel": "answer",
              "model": {
                "id": {
                  "name": "llm",
                  "provider": "gizclaw"
                }
              },
              "stream": true,
              "system_prompt": "你是一个简短、准确的中文语音助手。\n相关长期记忆如下；如果为空就忽略：\n${board:recalled_memory}\n"
            },
            "id": "answer",
            "publish": true,
            "type": "inference"
          }
        ]
      },
      "max_iterations": 4,
      "memory_hooks": {
        "context": {
          "query": {
            "current_message": true
          },
          "budget": {
            "max_items": 5
          },
          "output": "recalled_memory_items",
          "render": {
            "output": "recalled_memory"
          }
        },
        "turn": {
          "channel": "answer"
        }
      }
    },
    "memory": "default-memory",
    "name": "flowcraft-configured-memory",
    "parameters": {
      "input": "push-to-talk"
    },
    "voice_adapter": {
      "asr_model": "asr",
      "default_voice": "narrator",
      "node_voices": {
        "answer": "narrator"
      }
    }
  }
}
