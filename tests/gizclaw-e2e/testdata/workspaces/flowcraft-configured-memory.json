{
  "agent": "flowcraft",
  "models": {
    "llm": "llm",
    "tts": "tts",
    "asr": "asr"
  },
  "workflow": {
    "name": "flowcraft-configured-memory",
    "description": "Flowcraft workflow using the configured provider-neutral memory store",
    "memory": "default-memory",
    "flowcraft": {
      "conversation": {
        "starts": "peer"
      },
      "graph": {
        "edges": [
          {
            "from": "recall-memory",
            "to": "answer"
          },
          {
            "from": "answer",
            "to": "observe-turn"
          },
          {
            "from": "observe-turn",
            "to": "__end__"
          }
        ],
        "entry": "recall-memory",
        "name": "Configured Memory Assistant",
        "nodes": [
          {
            "id": "recall-memory",
            "type": "memory_recall",
            "config": {
              "query": {
                "text_from": "input"
              },
              "output": "recalled_memory",
              "top_k": 5
            }
          },
          {
            "config": {
              "max_tokens": 2048,
              "model": "llm",
              "system_prompt": "你是一个简短、准确的中文语音助手。\n相关长期记忆如下；如果为空就忽略：\n${board.recalled_memory}\n"
            },
            "id": "answer",
            "publish": true,
            "type": "llm"
          },
          {
            "id": "observe-turn",
            "type": "memory_observe",
            "config": {
              "observations": [
                {
                  "turns_from": "conversation"
                },
                {
                  "facts": [
                    {
                      "attributes": {
                        "lane": "owner-profile"
                      },
                      "text_from": "input"
                    }
                  ]
                }
              ],
              "wait_for_completion": true
            }
          }
        ]
      },
      "max_iterations": 4
    },
    "parameters": {
      "input": "push-to-talk"
    },
    "voice_adapter": {
      "asr_model": "asr",
      "default_voice": "narrator",
      "node_voices": {
        "answer": "narrator"
      }
    }
  },
  "voice": "assistant-voice",
  "rounds": 1,
  "timeout": "300s",
  "persona": "You are a concise Chinese voice chat test user. Keep every utterance short and speech friendly."
}
