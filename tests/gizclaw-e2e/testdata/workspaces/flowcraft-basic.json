{
  "agent": "flowcraft",
  "models": {
    "asr": "asr",
    "llm": "llm",
    "tts": "tts"
  },
  "persona": "You are a concise Chinese voice chat test user. Keep every utterance short and speech friendly.",
  "rounds": 3,
  "interrupt": {
    "rounds": 3
  },
  "timeout": "1200s",
  "voice": "assistant-voice",
  "workflow": {
    "description": "Flowcraft voice adapter workflow",
    "flowcraft": {
      "conversation": {
        "starts": "peer"
      },
      "graph": {
        "edges": [
          {
            "from": "answer",
            "to": "observe-conversation"
          },
          {
            "from": "observe-conversation",
            "to": "__end__"
          }
        ],
        "entry": "answer",
        "name": "Assistant",
        "nodes": [
          {
            "config": {
              "max_tokens": 2048,
              "model": "llm",
              "system_prompt": "你是一个简短、自然的中文语音聊天助手。直接回答用户，不要解释测试流程。"
            },
            "id": "answer",
            "publish": true,
            "type": "llm"
          },
          {
            "config": {
              "observations": [
                {
                  "facts": [
                    {
                      "attributes": {
                        "lane": "conversation-memory"
                      },
                      "text_from": "input"
                    }
                  ]
                }
              ],
              "wait_for_completion": false
            },
            "id": "observe-conversation",
            "type": "memory_observe"
          }
        ]
      },
      "max_iterations": 4
    },
    "name": "flowcraft-voice-assistant",
    "parameters": {
      "input": "push-to-talk"
    },
    "memory": "voice-assistant-memory",
    "voice_adapter": {
      "asr_model": "asr",
      "default_voice": "narrator",
      "node_voices": {
        "answer": "narrator"
      }
    }
  }
}
