{
  "agent": "eino",
  "models": {
    "asr": "asr",
    "llm": "llm",
    "tts": "tts"
  },
  "persona": "You are a concise Chinese voice chat test user. Keep every utterance short and speech friendly.",
  "rounds": 3,
  "interrupt": {
    "rounds": 3
  },
  "timeout": "1200s",
  "voice": "assistant-voice",
  "workflow": {
    "eino": {
      "graph": {
        "name": "Assistant",
        "compile": {
          "node_trigger_mode": "any_predecessor",
          "max_run_steps": 24
        },
        "state": {
          "fields": [
            {
              "name": "values",
              "type": "object",
              "merge": "replace"
            },
            {
              "name": "channels",
              "type": "object",
              "merge": "replace"
            },
            {
              "name": "answer-messages",
              "type": "messages",
              "merge": "replace"
            },
            {
              "name": "answer-text",
              "type": "string",
              "merge": "replace"
            },
            {
              "name": "observe-conversation-fact-0",
              "type": "string",
              "merge": "replace"
            },
            {
              "name": "observe-conversation-attribute-0-lane",
              "type": "string",
              "merge": "replace"
            }
          ]
        },
        "nodes": [
          {
            "id": "initialize-conversation",
            "type": "script",
            "language": "starlark",
            "entrypoint": "run",
            "source": "def run(input):\n    values = json.decode(json.encode(input[\"values\"]))\n    channels = json.decode(json.encode(input[\"channels\"]))\n    channels[\"main\"] = json.decode(json.encode(input[\"history\"]))\n    values[\"input\"] = input[\"text\"]\n    values[\"safety_fence\"] = input[\"fence\"]\n    return {\"values\":values,\"channels\":channels}\n",
            "inputs": {
              "values": {
                "from": "values"
              },
              "channels": {
                "from": "channels"
              },
              "history": {
                "from": "input.messages"
              },
              "fence": {
                "from": "input.safety_fence"
              },
              "text": {
                "from": "input.text"
              }
            },
            "outputs": {
              "values": "values",
              "channels": "channels"
            },
            "limits": {
              "max_execution_steps": 1000000,
              "timeout": "1s",
              "max_input_bytes": 1048576,
              "max_output_bytes": 1048576
            }
          },
          {
            "id": "answer-prompt",
            "type": "script",
            "language": "starlark",
            "entrypoint": "run",
            "source": "def run(input):\n    values = json.decode(json.encode(input[\"values\"]))\n    channels = json.decode(json.encode(input[\"channels\"]))\n    values[\"safety_fence\"] = input[\"fence\"]\n    prompt = '你是一个简短、自然的中文语音聊天助手。直接回答用户，不要解释测试流程。'\n    messages = [{\"role\":\"system\",\"content\":prompt}] if prompt else []\n    for message in channels.get('main', []):\n        content = message.get(\"content\", \"\")\n        if not content:\n            content = \"\".join([part.get(\"text\", \"\") for part in message.get(\"parts\", []) if part.get(\"type\") == \"text\"])\n        messages.append({\"role\":message.get(\"role\", \"user\"),\"content\":content})\n    return {\"values\":values,\"channels\":channels,\"messages\":messages}\n",
            "inputs": {
              "values": {
                "from": "values"
              },
              "channels": {
                "from": "channels"
              },
              "fence": {
                "from": "input.safety_fence"
              }
            },
            "outputs": {
              "values": "values",
              "channels": "channels",
              "messages": "answer-messages"
            },
            "limits": {
              "max_execution_steps": 1000000,
              "timeout": "1s",
              "max_input_bytes": 1048576,
              "max_output_bytes": 1048576
            }
          },
          {
            "id": "answer",
            "type": "chat_model",
            "model": "llm",
            "inputs": {
              "messages": {
                "from": "answer-messages"
              }
            },
            "outputs": {
              "text": "answer-text"
            },
            "max_tokens": 2048
          },
          {
            "id": "answer-capture",
            "type": "script",
            "language": "starlark",
            "entrypoint": "run",
            "source": "def run(input):\n    values = json.decode(json.encode(input[\"values\"]))\n    channels = json.decode(json.encode(input[\"channels\"]))\n    text = input[\"answer\"]\n    channels.setdefault(\"main\", []).append({\"role\":\"assistant\",\"content\":text})\n    return {\"values\":values,\"channels\":channels}\n",
            "inputs": {
              "values": {
                "from": "values"
              },
              "channels": {
                "from": "channels"
              },
              "answer": {
                "from": "answer-text"
              }
            },
            "outputs": {
              "values": "values",
              "channels": "channels"
            },
            "limits": {
              "max_execution_steps": 1000000,
              "timeout": "1s",
              "max_input_bytes": 1048576,
              "max_output_bytes": 1048576
            }
          },
          {
            "id": "observe-conversation-prepare-0",
            "type": "script",
            "language": "starlark",
            "entrypoint": "run",
            "source": "def run(input):\n    values = json.decode(json.encode(input[\"values\"]))\n    channels = json.decode(json.encode(input[\"channels\"]))\n    fact_0 = input[\"text\"]\n    return {\"values\":values,\"channels\":channels,'fact-0':fact_0,'attribute-0-lane':'conversation-memory'}\n",
            "inputs": {
              "values": {
                "from": "values"
              },
              "channels": {
                "from": "channels"
              },
              "text": {
                "from": "input.text"
              }
            },
            "outputs": {
              "values": "values",
              "channels": "channels",
              "fact-0": "observe-conversation-fact-0",
              "attribute-0-lane": "observe-conversation-attribute-0-lane"
            },
            "limits": {
              "max_execution_steps": 1000000,
              "timeout": "1s",
              "max_input_bytes": 1048576,
              "max_output_bytes": 1048576
            }
          },
          {
            "id": "observe-conversation",
            "type": "memory_observe",
            "wait_for_completion": false,
            "facts": [
              {
                "text_from": "observe-conversation-fact-0",
                "attributes": {
                  "lane": "observe-conversation-attribute-0-lane"
                }
              }
            ]
          }
        ],
        "edges": [
          {
            "from": "start",
            "to": "initialize-conversation"
          },
          {
            "from": "answer-prompt",
            "to": "answer"
          },
          {
            "from": "answer",
            "to": "answer-capture"
          },
          {
            "from": "observe-conversation-prepare-0",
            "to": "observe-conversation"
          },
          {
            "from": "initialize-conversation",
            "to": "answer-prompt"
          },
          {
            "from": "answer-capture",
            "to": "observe-conversation-prepare-0"
          },
          {
            "from": "observe-conversation",
            "to": "end"
          }
        ],
        "branches": [],
        "outputs": [
          {
            "node": "answer",
            "field": "answer-text",
            "name": "answer",
            "mime_type": "text/plain",
            "primary": true
          }
        ]
      },
      "state_persistence": {
        "fields": [
          "values",
          "channels"
        ]
      },
      "conversation": {
        "starts": "peer"
      },
      "voice_adapter": {
        "asr_model": "asr",
        "default_voice": "narrator",
        "node_voices": {
          "answer": "narrator"
        }
      }
    },
    "name": "eino-voice-assistant",
    "parameters": {
      "input": "push-to-talk"
    },
    "memory": "voice-assistant-memory",
    "description": "Eino voice adapter workflow"
  }
}
