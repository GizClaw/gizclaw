identity:
  private-key: ${GIZCLAW_E2E_EDGE_PRIVATE_KEY}
listen: 0.0.0.0:9821
endpoint: ${GIZCLAW_E2E_EDGE_ENDPOINT}
upstreams:
  - endpoint: ${GIZCLAW_E2E_EDGE_UPSTREAM_ENDPOINT}
    public-key: ${GIZCLAW_E2E_EDGE_UPSTREAM_PUBLIC_KEY}
http:
  listeners:
    - listen: 0.0.0.0:9821
gateway:
  enabled: true
  max-sessions: ${GIZCLAW_E2E_GATEWAY_MAX_SESSIONS}
  max-upstreams: ${GIZCLAW_E2E_GATEWAY_MAX_UPSTREAMS}
  sessions-per-upstream: ${GIZCLAW_E2E_GATEWAY_SESSIONS_PER_UPSTREAM}
  channels-per-session: ${GIZCLAW_E2E_GATEWAY_CHANNELS_PER_SESSION}
  channels-per-upstream: ${GIZCLAW_E2E_GATEWAY_CHANNELS_PER_UPSTREAM}
  max-pending-handshakes: ${GIZCLAW_E2E_GATEWAY_MAX_PENDING_HANDSHAKES}
