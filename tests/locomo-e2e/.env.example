# Export only the variables required by the selected Go test group. Keep values
# out of committed files and command output.

# Shared live-run inputs and optional overrides.
GIZCLAW_LOCOMO_E2E_MODEL_API_KEY=
GIZCLAW_LOCOMO_E2E_MODEL_BASE_URL=https://api.deepseek.com
GIZCLAW_LOCOMO_E2E_MODEL_PROVIDER=deepseek
GIZCLAW_LOCOMO_E2E_MODEL_REGION=cn-beijing
GIZCLAW_LOCOMO_E2E_ANSWER_MODEL=deepseek-v4-flash
# Use tests/locomo-e2e/testdata/locomo10_conv30.jsonl for the complete conv-30 tier.
GIZCLAW_LOCOMO_E2E_DATASET=tests/locomo-e2e/testdata/locomo10_smoke.jsonl
GIZCLAW_LOCOMO_E2E_REPORT_DIR=tests/locomo-e2e/reports
GIZCLAW_LOCOMO_E2E_TOP_K=10
GIZCLAW_LOCOMO_E2E_INGEST_TIMEOUT=10m
GIZCLAW_LOCOMO_E2E_QA_TIMEOUT=2m
GIZCLAW_LOCOMO_E2E_MIN_F1=0.05
GIZCLAW_LOCOMO_E2E_MIN_EVIDENCE_HIT_RATE=0.50

# Flowcraft and self-hosted Mem0 model configuration.
GIZCLAW_LOCOMO_E2E_FLOWCRAFT_REDIS8_URL=redis://127.0.0.1:16380/0
GIZCLAW_LOCOMO_E2E_EXTRACTION_MODEL=deepseek-v4-flash
GIZCLAW_LOCOMO_E2E_EMBEDDING_API_KEY=
GIZCLAW_LOCOMO_E2E_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GIZCLAW_LOCOMO_E2E_EMBEDDING_MODEL=qwen3.7-text-embedding
GIZCLAW_LOCOMO_E2E_EMBEDDING_DIMENSIONS=1024
GIZCLAW_LOCOMO_E2E_RERANK_MODEL=

# Self-hosted Mem0 Docker endpoint.
GIZCLAW_LOCOMO_E2E_MEM0_SELF_HOSTED_URL=http://127.0.0.1:18000

# Optional remote Mem0 Platform profiles.
GIZCLAW_LOCOMO_E2E_MEM0_CUSTOM_INSTRUCTIONS_ENDPOINT=
GIZCLAW_LOCOMO_E2E_MEM0_CUSTOM_INSTRUCTIONS_API_KEY=
GIZCLAW_LOCOMO_E2E_MEM0_CUSTOM_INSTRUCTIONS_FINGERPRINT=
GIZCLAW_LOCOMO_E2E_MEM0_DEFAULT_ENDPOINT=
GIZCLAW_LOCOMO_E2E_MEM0_DEFAULT_API_KEY=
GIZCLAW_LOCOMO_E2E_MEM0_DEFAULT_FINGERPRINT=

# Volc AgentKit profile. Set the direct data-plane key, or leave it empty
# and provide the complete resolver tuple below.
GIZCLAW_LOCOMO_E2E_VOLC_MEM0_ENDPOINT=
GIZCLAW_LOCOMO_E2E_VOLC_MEM0_API_KEY=
GIZCLAW_LOCOMO_E2E_VOLC_DEFAULT_FINGERPRINT=
GIZCLAW_LOCOMO_E2E_VOLC_MEMORY_PROJECT_ID=
GIZCLAW_LOCOMO_E2E_VOLC_API_KEY_ID=
GIZCLAW_LOCOMO_E2E_VOLC_ACCESS_KEY_ID=
GIZCLAW_LOCOMO_E2E_VOLC_ACCESS_KEY_SECRET=
GIZCLAW_LOCOMO_E2E_VOLC_CONTROL_ENDPOINT=
GIZCLAW_LOCOMO_E2E_VOLC_REGION=cn-beijing
