{
  "name": "@gizclaw/monitor",
  "version": "0.1.0",
  "description": "GizClaw monitoring console with a standalone static server",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GizClaw/gizclaw.git",
    "directory": "web/console"
  },
  "homepage": "https://gizclaw.github.io/gizclaw/zh/developing/monitor",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=23.5.0"
  },
  "bin": {
    "gizclaw-monitor": "serve.mjs"
  },
  "files": [
    "dist",
    "serve.mjs",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:embedded": "npm run build && node embed.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node serve.mjs",
    "prepack": "npm run build && node package.mjs",
    "test": "node --test embed.test.mjs serve.test.mjs && vitest run",
    "test:standalone": "node --test serve.test.mjs && vitest run",
    "test:package": "node --test package.test.mjs",
    "prebuild": "npm run build --prefix ../../sdk/js/gizclaw-control",
    "pretest": "npm run build --prefix ../../sdk/js/gizclaw-control"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "@assistant-ui/react": "0.15.19",
    "@gizclaw/assistant": "0.1.0",
    "@gizclaw/gizclaw": "^0.0.0",
    "@gizclaw/gizclaw-control": "*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  }
}
