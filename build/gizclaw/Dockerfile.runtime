# Runtime packaging only: the executable comes from the verified Release .deb.
FROM ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3

ARG VERSION
ARG SOURCE_COMMIT
ARG CREATED
LABEL org.opencontainers.image.title="GizClaw" \
      org.opencontainers.image.description="GizClaw Server and CLI" \
      org.opencontainers.image.source="https://github.com/GizClaw/gizclaw" \
      org.opencontainers.image.url="https://github.com/orgs/GizClaw/packages/container/package/gizclaw" \
      org.opencontainers.image.documentation="https://github.com/GizClaw/gizclaw/blob/main/guides/en/using/container.md" \
      org.opencontainers.image.licenses="BSD-3-Clause" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.base.name="ubuntu:24.04" \
      org.opencontainers.image.base.digest="sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3"

COPY gizclaw.deb /tmp/gizclaw.deb
COPY LICENSE /usr/share/doc/gizclaw/LICENSE
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl /tmp/gizclaw.deb \
    && rm -rf /var/lib/apt/lists/* /tmp/gizclaw.deb \
    && groupadd --gid 10001 gizclaw \
    && useradd --uid 10001 --gid 10001 --home-dir /var/lib/gizclaw --no-create-home gizclaw \
    && install -d -o 10001 -g 10001 /var/lib/gizclaw

COPY --chmod=0755 runtime-entrypoint.sh /usr/local/bin/gizclaw-entrypoint

USER 10001:10001
WORKDIR /var/lib/gizclaw
EXPOSE 9820/tcp 9820/udp
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/gizclaw-entrypoint"]
CMD ["serve", "--force", "/var/lib/gizclaw"]
