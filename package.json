{
  "name": "gizclaw-go",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=23.5.0"
  },
  "workspaces": [
    "sdk/js",
    "sdk/js/gizclaw",
    "sdk/js/gizclaw-control",
    "web/monitor"
  ],
  "devDependencies": {
    "@types/node": "26.4.0",
    "oxlint": "1.80.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "yaml": "2.9.0"
  },
  "scripts": {
    "quality:typescript": "tsc --noEmit -p sdk/js/gizclaw/tsconfig.json && npm run build --workspace @gizclaw/gizclaw && tsc --noEmit -p sdk/js/gizclaw-control/tsconfig.json && npm run build --workspace @gizclaw/gizclaw-control && tsc --noEmit -p tests/gizclaw-e2e/js/tsconfig.json",
    "quality:lint": "oxlint --deny-warnings --ignore-path .prettierignore sdk/js tests/gizclaw-e2e/js web/monitor/src",
    "quality:format": "prettier --check sdk/js tests/gizclaw-e2e/js web/monitor/src web/monitor/vite.config.ts",
    "build:monitor": "npm run build --workspace @gizclaw/monitor"
  }
}
