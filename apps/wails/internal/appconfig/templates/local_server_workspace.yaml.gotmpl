identity:
  private-key: {{ quote .PrivateKey }}
listen: {{ quote .Listen }}
endpoint: {{ quote .Endpoint }}
serve-to-clients: {{ .ServeToClients }}
{{ if .AdminPublicKey }}
admin-public-key: {{ quote .AdminPublicKey }}
{{ end }}

storage:
  process-memory:
    kind: memory

  local-kv:
    kind: badger
    dir: data/kv

  local-files:
    kind: filesystem.dir
    dir: data/objects

  gameplay-db:
    kind: sqlite
    dir: data/gameplay.sqlite

stores:
  peers:
    kind: keyvalue
    storage: local-kv
    prefix: peers

  api-keys:
    kind: keyvalue
    storage: local-kv
    prefix: api-keys

  flowcraft-state:
    kind: keyvalue
    storage: local-kv
    prefix: flowcraft-state

  credentials:
    kind: keyvalue
    storage: local-kv
    prefix: credentials

  firmwares:
    kind: keyvalue
    storage: local-kv
    prefix: firmwares

  runtime-profiles:
    kind: keyvalue
    storage: local-kv
    prefix: runtime-profiles

  models:
    kind: keyvalue
    storage: local-kv
    prefix: models

  voices:
    kind: keyvalue
    storage: local-kv
    prefix: voices

  memory-layouts:
    kind: keyvalue
    storage: local-kv
    prefix: memory-layouts

  provider-tenants:
    kind: keyvalue
    storage: local-kv
    prefix: provider-tenants

  workflows:
    kind: keyvalue
    storage: local-kv
    prefix: workflows

  workspaces:
    kind: keyvalue
    storage: local-kv
    prefix: workspaces

  tools:
    kind: keyvalue
    storage: local-kv
    prefix: tools

  contacts:
    kind: keyvalue
    storage: local-kv
    prefix: contacts

  friends:
    kind: keyvalue
    storage: local-kv
    prefix: friends

  friend-groups:
    kind: keyvalue
    storage: local-kv
    prefix: friend-groups

  gameplay:
    kind: keyvalue
    storage: local-kv
    prefix: gameplay

  agenthost:
    kind: objectstore
    storage: local-files
    prefix: agenthost

  workspace-assets:
    kind: objectstore
    storage: local-files
    prefix: workspaces

  gameplay-assets:
    kind: objectstore
    storage: local-files
    prefix: gameplay

  gameplay-db:
    kind: sql
    storage: gameplay-db

  metrics:
    kind: metrics
    storage: process-memory

services:
  peer:
    store: peers

  api_key:
    store: api-keys

  credential:
    store: credentials

  firmware:
    store: firmwares

  runtime_profile:
    store: runtime-profiles

  model:
    store: models

  voice:
    store: voices

  memory_layout:
    store: memory-layouts

  provider_tenants:
    store: provider-tenants

  workflow:
    store: workflows

  workspace:
    store: workspaces
    assets_store: workspace-assets

  toolkit:
    store: tools

  contact:
    store: contacts

  friend:
    store: friends

  friend_group:
    store: friend-groups

  gameplay:
    store: gameplay
    assets_store: gameplay-assets
    database_store: gameplay-db

  agent_host:
    runtime_store: agenthost
    flowcraft:
      state_store: flowcraft-state

  metrics:
    store: metrics

  system_log:
    level: info
    sinks:
      - kind: stderr
