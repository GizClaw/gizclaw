        "required": ["name", "display_name", "prefix", "api_key", "manage_api_keys", "created_at"],
        "properties": {
          "name": {"type": "string", "description": "Opaque API key identity.", "minLength": 26, "maxLength": 26, "pattern": "^key_[A-Za-z0-9_-]{22}$"},
          "display_name": {"type": "string", "description": "Trimmed UTF-8 display name; the server enforces an 80-byte maximum.", "minLength": 1, "maxLength": 80},
          "prefix": {"type": "string", "description": "Short display prefix; the complete API key is also returned."},
          "api_key": {"type": "string", "description": "Complete recoverable API key stored by the server.", "minLength": 57, "maxLength": 57, "pattern": "^gizclaw_sk_v1_[A-Za-z0-9_-]{43}$"},
          "manage_api_keys": {"type": "boolean"},
          "created_at": {"type": "string", "format": "date-time"}
        }
      },
      "APIKeyCreateRequest": {
