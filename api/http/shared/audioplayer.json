{
  "openapi": "3.0.3",
  "info": {
    "title": "Device Audio Player",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "AudioPlayerItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 1024,
            "description": "HTTPS audio URL without embedded credentials; at most 1024 UTF-8 bytes."
          },
          "title": {
            "type": "string",
            "maxLength": 128
          },
          "source_ref": {
            "type": "string",
            "maxLength": 128
          }
        }
      },
      "AudioPlayerStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "position_ms",
          "repeat",
          "playlist_length",
          "playlist_revision",
          "observed_at_unix_ms"
        ],
        "properties": {
          "state": {
            "type": "string",
            "description": "Device state: stopped, buffering, playing, ended or error."
          },
          "current_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          },
          "position_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "duration_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "repeat": {
            "type": "string",
            "description": "off, one or all."
          },
          "playlist_length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32
          },
          "playlist_revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 4294967295
          },
          "error_code": {
            "type": "string",
            "maxLength": 128
          },
          "error_message": {
            "type": "string",
            "maxLength": 512
          },
          "observed_at_unix_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "AudioPlayerResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/AudioPlayerStatus"
          }
        }
      },
      "AudioPlayerPlaylist": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "playlist_revision"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "$ref": "#/components/schemas/AudioPlayerItem"
            }
          },
          "playlist_revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 4294967295
          }
        }
      },
      "AudioPlayerPlaylistSetRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "$ref": "#/components/schemas/AudioPlayerItem"
            }
          }
        }
      },
      "AudioPlayerPlaylistAppendRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "$ref": "#/components/schemas/AudioPlayerItem"
            }
          }
        }
      },
      "AudioPlayerPlayRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31,
            "x-go-type": "*int"
          }
        }
      },
      "AudioPlayerModeSetRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repeat"
        ],
        "properties": {
          "repeat": {
            "type": "string",
            "enum": [
              "off",
              "one",
              "all"
            ]
          }
        }
      }
    }
  }
}
