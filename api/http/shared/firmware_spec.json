{
  "openapi": "3.0.3",
  "info": {
    "title": "Firmware Spec Type",
    "description": "Firmware spec schema.",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "FirmwareSpecSlot": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 1024,
            "example": "Devkit firmware 1.0.3"
          },
          "package": {
            "$ref": "./firmware_package.json#/components/schemas/FirmwarePackage",
            "description": "Operator-owned external .tar.zlib package configuration for this channel."
          }
        }
      },
      "FirmwareSpecSlots": {
        "type": "object",
        "required": [
          "stable",
          "beta",
          "develop"
        ],
        "additionalProperties": false,
        "properties": {
          "stable": {
            "$ref": "#/components/schemas/FirmwareSpecSlot"
          },
          "beta": {
            "$ref": "#/components/schemas/FirmwareSpecSlot"
          },
          "develop": {
            "$ref": "#/components/schemas/FirmwareSpecSlot"
          }
        }
      },
      "FirmwareSpec": {
        "type": "object",
        "required": [
          "slots"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "example": "Devkit firmware channels"
          },
          "slots": {
            "$ref": "#/components/schemas/FirmwareSpecSlots"
          }
        }
      }
    }
  }
}
