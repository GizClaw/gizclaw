{
  "openapi": "3.0.3",
  "info": {
    "title": "Firmware Package Type",
    "description": "External firmware package configuration schema.",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "FirmwarePackage": {
        "type": "object",
        "required": [
          "url",
          "sha256",
          "size"
        ],
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "description": "Operator-owned HTTPS URL for the exact .tar.zlib archive bytes.",
            "example": "https://firmware.example.com/devkit/1.0.3.tar.zlib"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Lowercase SHA-256 digest of the complete .tar.zlib archive bytes."
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Exact .tar.zlib archive size in bytes."
          },
          "version": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
            "description": "SemVer 2.0.0 package release version without a leading v. Build metadata does not affect version precedence; SHA-256 identifies exact archive bytes. Omitted when the stored package has no version. A valid version is required when creating or updating a package.",
            "example": "1.5.0-beta.1+abc123"
          }
        }
      }
    }
  }
}
