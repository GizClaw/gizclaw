{
  "openapi": "3.0.3",
  "info": {
    "title": "Doubao Realtime Duplex Workflow Type",
    "description": "DoubaoRealtimeDuplexWorkflowSpec schema.",
    "version": "1.0.0"
  },
  "paths": {},
