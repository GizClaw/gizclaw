{
  "openapi": "3.0.3",
  "info": {
    "title": "Flowcraft Workflow Type",
    "description": "Strongly typed GizClaw Flowcraft workflow policy.",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "FlowcraftWorkflowSpec": {
        "type": "object",
        "required": ["graph"],
        "additionalProperties": false,
        "properties": {
          "graph": { "$ref": "#/components/schemas/FlowcraftGraph" },
          "max_iterations": { "type": "integer", "minimum": 1 },
          "conversation": { "$ref": "#/components/schemas/FlowcraftConversation" },
          "voice_adapter": { "$ref": "#/components/schemas/FlowcraftVoiceAdapter" }
        },
        "example": {
          "graph": {
            "name": "Assistant",
            "entry": "answer",
            "nodes": [
              {
                "id": "answer",
                "type": "llm",
                "publish": true,
                "config": {
                  "model": "llm",
                  "max_tokens": 2048
                }
              }
            ],
            "edges": [{ "from": "answer", "to": "__end__" }]
          },
          "max_iterations": 8,
          "conversation": { "starts": "peer" },
          "voice_adapter": { "asr_model": "asr", "default_voice": "narrator", "node_voices": { "answer": "narrator" } }
        }
      },
      "FlowcraftGraph": {
        "type": "object",
        "required": ["name", "entry", "nodes"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string", "minLength": 1 },
          "entry": { "type": "string", "minLength": 1 },
          "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/FlowcraftNode" } },
          "edges": { "type": "array", "items": { "$ref": "#/components/schemas/FlowcraftEdge" } }
        }
      },
      "FlowcraftNode": {
        "oneOf": [
          { "$ref": "#/components/schemas/FlowcraftLLMNode" },
          { "$ref": "#/components/schemas/FlowcraftScriptNode" },
          { "$ref": "#/components/schemas/FlowcraftPassthroughNode" },
          { "$ref": "#/components/schemas/FlowcraftMemoryRecallNode" },
          { "$ref": "#/components/schemas/FlowcraftMemoryObserveNode" }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "llm": "#/components/schemas/FlowcraftLLMNode",
            "script": "#/components/schemas/FlowcraftScriptNode",
            "passthrough": "#/components/schemas/FlowcraftPassthroughNode",
            "memory_recall": "#/components/schemas/FlowcraftMemoryRecallNode",
            "memory_observe": "#/components/schemas/FlowcraftMemoryObserveNode"
          }
        }
      },
      "FlowcraftNodeBase": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string" },
          "publish": { "type": "boolean" },
          "skip_condition": { "type": "string" }
        }
      },
      "FlowcraftLLMNode": {
        "allOf": [
          { "$ref": "#/components/schemas/FlowcraftNodeBase" },
          {
            "type": "object",
            "required": ["type", "config"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "enum": ["llm"] },
              "publish": { "type": "boolean" },
              "skip_condition": { "type": "string" },
              "config": { "$ref": "#/components/schemas/FlowcraftLLMNodeConfig" }
            }
          }
        ]
      },
      "FlowcraftScriptNode": {
        "allOf": [
          { "$ref": "#/components/schemas/FlowcraftNodeBase" },
          {
            "type": "object",
            "required": ["type", "config"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "enum": ["script"] },
              "publish": { "type": "boolean" },
              "skip_condition": { "type": "string" },
              "config": { "$ref": "#/components/schemas/FlowcraftScriptNodeConfig" }
            }
          }
        ]
      },
      "FlowcraftPassthroughNode": {
        "type": "object",
        "required": ["id", "type"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["passthrough"] },
          "publish": { "type": "boolean" },
          "skip_condition": { "type": "string" }
        }
      },
      "FlowcraftMemoryRecallNode": {
        "type": "object",
        "required": ["id", "type", "config"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["memory_recall"] },
          "publish": { "type": "boolean" },
          "skip_condition": { "type": "string" },
          "config": { "$ref": "#/components/schemas/FlowcraftMemoryRecallNodeConfig" }
        }
      },
      "FlowcraftMemoryRecallNodeConfig": {
        "type": "object",
        "required": ["query", "output", "top_k"],
        "additionalProperties": false,
        "properties": {
          "query": { "$ref": "#/components/schemas/FlowcraftMemoryRecallQuery" },
          "output": { "type": "string", "minLength": 1 },
          "render": { "$ref": "#/components/schemas/FlowcraftMemoryRecallRender" },
          "top_k": { "type": "integer", "minimum": 1 }
        }
      },
      "FlowcraftMemoryRecallQuery": {
        "type": "object",
        "required": ["text_from"],
        "additionalProperties": false,
        "properties": {
          "text_from": { "type": "string", "minLength": 1 },
          "kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["event", "state", "preference", "procedure", "relation", "plan", "note", "episode"]
            }
          },
          "lanes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "filters": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FlowcraftMemoryFilter" }
          }
        }
      },
      "FlowcraftMemoryFilter": {
        "type": "object",
        "required": ["field", "value"],
        "additionalProperties": false,
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "operator": { "type": "string", "enum": ["eq"] },
          "value": {}
        }
      },
      "FlowcraftMemoryRecallRender": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "header": { "type": "string" },
          "item_prefix": { "type": "string" },
          "max_items": { "type": "integer", "minimum": 1 }
        }
      },
      "FlowcraftMemoryObserveNode": {
        "type": "object",
        "required": ["id", "type", "config"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["memory_observe"] },
          "publish": { "type": "boolean" },
          "skip_condition": { "type": "string" },
          "config": { "$ref": "#/components/schemas/FlowcraftMemoryObserveNodeConfig" }
        }
      },
      "FlowcraftMemoryObserveNodeConfig": {
        "type": "object",
        "required": ["observations"],
        "additionalProperties": false,
        "properties": {
          "observations": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/FlowcraftMemoryObservation" }
          },
          "wait_for_completion": { "type": "boolean" }
        }
      },
      "FlowcraftMemoryObservation": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "turns_from": { "type": "string", "minLength": 1 },
          "text_from": { "type": "string", "minLength": 1 },
          "facts": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/FlowcraftMemoryFact" }
          }
        }
      },
      "FlowcraftMemoryFact": {
        "type": "object",
        "required": ["text_from"],
        "additionalProperties": false,
        "properties": {
          "text_from": { "type": "string", "minLength": 1 },
          "attributes": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      },
      "FlowcraftLLMNodeConfig": {
        "type": "object",
        "required": ["model"],
        "additionalProperties": false,
        "properties": {
          "model": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "system_prompt": { "type": "string" },
          "temperature": { "type": "number" },
          "max_tokens": { "type": "integer", "minimum": 1 },
          "output_key": { "type": "string" },
          "messages_channel": { "type": "string" },
          "json_mode": { "type": "boolean" },
          "thinking": { "type": "boolean" },
          "track_steps": { "type": "boolean" }
        }
      },
      "FlowcraftScriptNodeConfig": {
        "type": "object",
        "required": ["source"],
        "additionalProperties": false,
        "properties": { "source": { "type": "string", "minLength": 1 } }
      },
      "FlowcraftEdge": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "condition": { "type": "string" }
        }
      },
      "FlowcraftConversation": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "starts": { "type": "string", "enum": ["peer", "agent"] } }
      },
      "FlowcraftVoiceAdapter": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "asr_model": { "type": "string", "maxLength": 63, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "default_voice": { "type": "string", "maxLength": 63, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "node_voices": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 63, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } }
        }
      }
    }
  }
}
