{
  "openapi": "3.0.3",
  "info": {
    "title": "Flowcraft Workflow Type",
    "description": "Strongly typed GizClaw Flowcraft workflow policy.",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "FlowcraftWorkflowSpec": {
        "type": "object",
        "required": ["graph"],
        "additionalProperties": false,
        "properties": {
          "graph": { "$ref": "#/components/schemas/FlowcraftGraph" },
          "max_iterations": { "type": "integer", "minimum": 1 },
          "memory_hooks": { "$ref": "#/components/schemas/FlowcraftMemoryHooks" },
          "conversation": { "$ref": "#/components/schemas/FlowcraftConversation" },
          "voice_adapter": { "$ref": "./voice_adapter.json#/components/schemas/VoiceAdapter" }
        },
        "example": {
          "graph": {
            "name": "Assistant",
            "entry": "answer",
            "nodes": [
              {
                "id": "answer",
                "type": "inference",
                "publish": true,
                "config": {
                  "model": { "id": { "provider": "gizclaw", "name": "llm" } },
                  "stream": true,
                  "intent": { "text": { "max_output_tokens": 2048 } }
                }
              }
            ],
            "edges": [{ "from": "answer", "to": "__end__" }]
          },
          "max_iterations": 8,
          "conversation": { "starts": "peer" },
          "voice_adapter": { "asr_model": "asr", "default_voice": "narrator", "node_voices": { "answer": "narrator" } }
        }
      },
      "FlowcraftMemoryHooks": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "context": { "$ref": "#/components/schemas/FlowcraftMemoryContextHook" },
          "turn": { "$ref": "#/components/schemas/FlowcraftMemoryTurnHook" }
        }
      },
      "FlowcraftMemoryContextHook": {
        "type": "object",
        "required": ["query", "output"],
        "additionalProperties": false,
        "properties": {
          "query": { "$ref": "#/components/schemas/FlowcraftMemoryContextQuery" },
          "dataset_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "budget": { "$ref": "#/components/schemas/FlowcraftMemoryContextBudget" },
          "min_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "output": { "type": "string", "minLength": 1 },
          "render": { "$ref": "#/components/schemas/FlowcraftMemoryContextRender" }
        }
      },
      "FlowcraftMemoryContextQuery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "literal": { "type": "string", "minLength": 1 },
          "board": { "type": "string", "minLength": 1 },
          "current_message": { "type": "boolean" },
          "recent_only": { "type": "boolean" }
        }
      },
      "FlowcraftMemoryContextBudget": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "max_tokens": { "type": "integer", "minimum": 0 },
          "max_items": { "type": "integer", "minimum": 0 },
          "max_chars": { "type": "integer", "minimum": 0 }
        }
      },
      "FlowcraftMemoryContextRender": {
        "type": "object",
        "required": ["output"],
        "additionalProperties": false,
        "properties": {
          "output": { "type": "string", "minLength": 1 },
          "template": { "type": "string" },
          "max_chars": { "type": "integer", "minimum": 0 }
        }
      },
      "FlowcraftMemoryTurnHook": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "channel": { "type": "string", "minLength": 1 }
        }
      },
      "FlowcraftGraph": {
        "type": "object",
        "required": ["name", "entry", "nodes"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string", "minLength": 1 },
          "entry": { "type": "string", "minLength": 1 },
          "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/FlowcraftNode" } },
          "edges": { "type": "array", "items": { "$ref": "#/components/schemas/FlowcraftEdge" } }
        }
      },
      "FlowcraftNode": {
        "oneOf": [
          { "$ref": "#/components/schemas/FlowcraftInferenceNode" },
          { "$ref": "#/components/schemas/FlowcraftScriptNode" },
          { "$ref": "#/components/schemas/FlowcraftPassthroughNode" },
          { "$ref": "#/components/schemas/FlowcraftMemoryRecallNode" },
          { "$ref": "#/components/schemas/FlowcraftMemoryObserveNode" }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "inference": "#/components/schemas/FlowcraftInferenceNode",
            "script": "#/components/schemas/FlowcraftScriptNode",
            "passthrough": "#/components/schemas/FlowcraftPassthroughNode",
            "memory_recall": "#/components/schemas/FlowcraftMemoryRecallNode",
            "memory_observe": "#/components/schemas/FlowcraftMemoryObserveNode"
          }
        }
      },
      "FlowcraftNodeBase": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string" },
          "publish": { "type": "boolean" },
          "skip_condition": { "type": "string" }
        }
      },
      "FlowcraftInferenceNode": {
        "allOf": [
          { "$ref": "#/components/schemas/FlowcraftNodeBase" },
          {
            "type": "object",
            "required": ["type", "config"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "enum": ["inference"] },
              "publish": { "type": "boolean" },
              "skip_condition": { "type": "string" },
              "config": { "$ref": "#/components/schemas/FlowcraftInferenceNodeConfig" }
            }
          }
        ]
      },
      "FlowcraftScriptNode": {
        "allOf": [
          { "$ref": "#/components/schemas/FlowcraftNodeBase" },
          {
            "type": "object",
            "required": ["type", "config"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "enum": ["script"] },
              "publish": { "type": "boolean" },
              "skip_condition": { "type": "string" },
              "config": { "$ref": "#/components/schemas/FlowcraftScriptNodeConfig" }
            }
          }
        ]
      },
      "FlowcraftPassthroughNode": {
        "type": "object",
        "required": ["id", "type"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["passthrough"] },
          "publish": { "type": "boolean" },
          "skip_condition": { "type": "string" }
        }
      },
      "FlowcraftMemoryRecallNode": {
        "type": "object",
        "required": ["id", "type", "config"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["memory_recall"] },
          "publish": { "type": "boolean" },
          "skip_condition": { "type": "string" },
          "config": { "$ref": "#/components/schemas/FlowcraftMemoryRecallNodeConfig" }
        }
      },
      "FlowcraftMemoryRecallNodeConfig": {
        "type": "object",
        "required": ["query", "output", "top_k"],
        "additionalProperties": false,
        "properties": {
          "query": { "$ref": "#/components/schemas/FlowcraftMemoryRecallQuery" },
          "output": { "type": "string", "minLength": 1 },
          "render": { "$ref": "#/components/schemas/FlowcraftMemoryRecallRender" },
          "top_k": { "type": "integer", "minimum": 1 }
        }
      },
      "FlowcraftMemoryRecallQuery": {
        "type": "object",
        "required": ["text_from"],
        "additionalProperties": false,
        "properties": {
          "text_from": { "type": "string", "minLength": 1 },
          "kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["event", "state", "preference", "procedure", "relation", "plan", "note", "episode"]
            }
          },
          "lanes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "filters": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FlowcraftMemoryFilter" }
          }
        }
      },
      "FlowcraftMemoryFilter": {
        "type": "object",
        "required": ["field", "value"],
        "additionalProperties": false,
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "operator": { "type": "string", "enum": ["eq"] },
          "value": {}
        }
      },
      "FlowcraftMemoryRecallRender": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "header": { "type": "string" },
          "item_prefix": { "type": "string" },
          "max_items": { "type": "integer", "minimum": 1 }
        }
      },
      "FlowcraftMemoryObserveNode": {
        "type": "object",
        "required": ["id", "type", "config"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["memory_observe"] },
          "publish": { "type": "boolean" },
          "skip_condition": { "type": "string" },
          "config": { "$ref": "#/components/schemas/FlowcraftMemoryObserveNodeConfig" }
        }
      },
      "FlowcraftMemoryObserveNodeConfig": {
        "type": "object",
        "required": ["observations"],
        "additionalProperties": false,
        "properties": {
          "observations": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/FlowcraftMemoryObservation" }
          },
          "wait_for_completion": { "type": "boolean" }
        }
      },
      "FlowcraftMemoryObservation": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "turns_from": { "type": "string", "minLength": 1 },
          "text_from": { "type": "string", "minLength": 1 },
          "facts": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/FlowcraftMemoryFact" }
          }
        }
      },
      "FlowcraftMemoryFact": {
        "type": "object",
        "required": ["text_from"],
        "additionalProperties": false,
        "properties": {
          "text_from": { "type": "string", "minLength": 1 },
          "attributes": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      },
      "FlowcraftInferenceNodeConfig": {
        "type": "object",
        "required": ["model"],
        "additionalProperties": false,
        "properties": {
          "model": { "$ref": "#/components/schemas/FlowcraftInferenceModelRef" },
          "system_prompt": { "type": "string" },
          "output_key": { "type": "string" },
          "messages_channel": { "type": "string" },
          "usage_key": { "type": "string" },
          "stream": { "type": "boolean" },
          "intent": { "$ref": "#/components/schemas/FlowcraftInferenceIntent" }
        }
      },
      "FlowcraftInferenceModelRef": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/components/schemas/FlowcraftInferenceModelID" }
        }
      },
      "FlowcraftInferenceModelID": {
        "type": "object",
        "required": ["provider", "name"],
        "additionalProperties": false,
        "properties": {
          "provider": { "type": "string", "enum": ["gizclaw"] },
          "name": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$" }
        }
      },
      "FlowcraftInferenceIntent": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "text": { "$ref": "#/components/schemas/FlowcraftInferenceTextIntent" }
        }
      },
      "FlowcraftInferenceTextIntent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "response": { "$ref": "#/components/schemas/FlowcraftInferenceResponseFormat" },
          "max_output_tokens": { "type": "integer", "minimum": 1 },
          "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
          "top_p": { "type": "number", "minimum": 0, "maximum": 1 },
          "reasoning_enabled": { "type": "boolean" }
        }
      },
      "FlowcraftInferenceResponseFormat": {
        "type": "object",
        "required": ["kind"],
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "enum": ["text", "json_object", "json_schema"] },
          "name": { "type": "string" },
          "schema": { "type": "object", "additionalProperties": true }
        }
      },
      "FlowcraftScriptNodeConfig": {
        "type": "object",
        "required": ["runtime", "source"],
        "additionalProperties": false,
        "properties": {
          "runtime": { "type": "string", "enum": ["js"] },
          "source": { "type": "string", "minLength": 1 }
        }
      },
      "FlowcraftEdge": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "condition": { "type": "string" }
        }
      },
      "FlowcraftConversation": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "starts": { "type": "string", "enum": ["peer", "agent"] } }
      }
    }
  }
}
