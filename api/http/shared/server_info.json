{
  "openapi": "3.0.3",
  "info": {
    "title": "Server Info Type",
    "description": "Server identity and status schema.",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "ServerInfo": {
        "type": "object",
        "required": [
          "public_key",
          "server_time",
          "version",
          "build_commit",
          "protocol",
          "signaling_path",
          "endpoint",
          "ice"
        ],
        "properties": {
          "public_key": {
            "type": "string"
          },
          "server_time": {
            "type": "integer",
            "format": "int64"
          },
          "version": {
            "type": "string",
            "description": "GizClaw software version embedded when the server binary was built. Formal releases use MAJOR.MINOR.PATCH without a leading v; development builds use dev."
          },
          "build_commit": {
            "type": "string",
            "description": "Source commit embedded when the server binary was built."
          },
          "region": {
            "type": "string",
            "description": "Operator-defined deployment region for this authoritative Server instance."
          },
          "protocol": {
            "type": "string"
          },
          "signaling_path": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "ice": {
            "type": "object",
            "required": [
              "udp",
              "tcp"
            ],
            "properties": {
              "udp": {
                "type": "boolean"
              },
              "tcp": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "ice_servers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "urls"
              ],
              "properties": {
                "urls": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "username": {
                  "type": "string"
                },
                "credential": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "transport": {
            "$ref": "#/components/schemas/ServerInfoTransport"
          }
        },
        "additionalProperties": false
      },
      "ServerInfoTransport": {
        "type": "object",
        "required": [
          "mode",
          "endpoint",
          "public_key",
          "signaling_path"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "edge-gateway"
            ]
          },
          "endpoint": {
            "type": "string"
          },
          "public_key": {
            "type": "string"
          },
          "signaling_path": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
