{
  "openapi": "3.0.3",
  "info": {
    "title": "Server Info Type",
    "description": "Server identity and status schema.",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "ServerInfo": {
        "type": "object",
        "required": [
          "public_key",
          "server_time",
          "version",
          "build_commit",
          "protocol",
          "signaling_path",
          "endpoint",
          "ice"
        ],
        "properties": {
          "public_key": {
            "type": "string"
          },
          "server_time": {
            "type": "integer",
            "format": "int64"
          },
          "version": {
            "type": "string",
            "description": "GizClaw software version embedded when the server binary was built. Formal releases use MAJOR.MINOR.PATCH without a leading v; development builds use dev."
          },
          "build_commit": {
            "type": "string",
            "description": "Source commit embedded when the server binary was built."
          },
          "protocol": {
            "type": "string"
          },
          "signaling_path": {
            "type": "string",
            "description": "Absolute path clients POST an encrypted WebRTC offer to, resolved against the base URL of the HTTP access point."
          },
          "endpoint": {
            "type": "string",
            "description": "Bare host[:port] the Server accepts WebRTC ICE UDP traffic on. An HTTP access point may terminate TLS on a different port that carries no ICE, so clients take the media address from here rather than from the URL they fetched this document with. A URL, path, query, userinfo, empty port or non-numeric port is invalid."
          },
          "ice": {
            "type": "object",
            "required": [
              "udp",
              "tcp"
            ],
            "properties": {
              "udp": {
                "type": "boolean"
              },
              "tcp": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "ice_servers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "urls"
              ],
              "properties": {
                "urls": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "username": {
                  "type": "string"
                },
                "credential": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "transport": {
            "$ref": "#/components/schemas/ServerInfoTransport"
          }
        },
        "additionalProperties": false
      },
      "ServerInfoTransport": {
        "type": "object",
        "description": "Edge gateway that terminates WebRTC signaling on behalf of the Server.",
        "required": [
          "mode",
          "endpoint",
          "public_key",
          "signaling_path"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "edge-gateway"
            ]
          },
          "endpoint": {
            "type": "string",
            "description": "Edge HTTP access point, either an http or https base URL or a bare host[:port] that inherits the scheme the client used to reach the Server."
          },
          "public_key": {
            "type": "string"
          },
          "signaling_path": {
            "type": "string",
            "description": "Absolute path clients POST an encrypted WebRTC offer to on the Edge."
          }
        },
        "additionalProperties": false
      }
    }
  }
}
