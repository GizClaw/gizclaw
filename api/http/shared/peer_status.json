{
  "openapi": "3.0.3",
  "info": {
    "title": "Peer Status Type",
    "description": "Optional peer-reported status schema.",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "PeerStatus": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "audioplayer": {"$ref": "./audioplayer.json#/components/schemas/AudioPlayerStatus"},
          "reported_at": {
            "type": "string",
            "format": "date-time"
          },
          "volume": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "muted": {
            "type": "boolean"
          },
          "battery_percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "charging": {
            "type": "boolean"
          },
          "gnss_latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "gnss_longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "gnss_altitude_m": {
            "type": "number"
          },
          "gnss_accuracy_m": {
            "type": "number",
            "minimum": 0
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          },
          "firmware_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Lowercase SHA-256 digest of the .tar.zlib package the device is currently running, as reported by the device."
          },
          "ota": {
            "$ref": "#/components/schemas/PeerOtaStatus"
          }
        }
      },
      "PeerOtaStatus": {
        "type": "object",
        "additionalProperties": false,
        "description": "Latest device-reported OTA attempt snapshot, retained across disconnects.",
        "required": [
          "state",
          "update_id",
          "observed_at"
        ],
        "properties": {
          "state": {
            "type": "string",
            "description": "Device-reported OTA state: started, downloading, succeeded, or failed. Readers must preserve unknown future values."
          },
          "update_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "download_percent": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 100
          },
          "target_version": {
            "type": "string",
            "maxLength": 128
          },
          "error_code": {
            "type": "string",
            "maxLength": 128
          },
          "error_message": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    }
  }
}
