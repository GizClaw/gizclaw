{
  "openapi": "3.0.3",
  "info": {
    "title": "Peer Status Type",
    "description": "Optional peer-reported status schema.",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "PeerStatus": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "audioplayer": {"$ref": "./audioplayer.json#/components/schemas/AudioPlayerStatus"},
          "reported_at": {
            "type": "string",
            "format": "date-time"
          },
          "volume": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "muted": {
            "type": "boolean"
          },
          "battery_percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "charging": {
            "type": "boolean"
          },
          "gnss_latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "gnss_longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "gnss_altitude_m": {
            "type": "number"
          },
          "gnss_accuracy_m": {
            "type": "number",
            "minimum": 0
          },
          "network_imei": {
            "type": "string",
            "pattern": "^[0-9]{15}$",
            "description": "Modem hardware IMEI from the latest cellular network telemetry observation: exactly 15 ASCII digits. Owner-scoped; never logged."
          },
          "network_imsi": {
            "type": "string",
            "pattern": "^[0-9]{6,15}$",
            "description": "IMSI of the SIM serving the default packet-data route from the latest cellular network telemetry observation: 6 to 15 ASCII digits. Owner-scoped; never logged."
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "activity": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,31}$",
            "description": "Stable machine-readable id of the feature the device reports it is currently using, e.g. \"chat\", \"audioplayer\", \"ota\", \"idle\". Readers must preserve unknown future values and localize by id rather than parsing it."
          },
          "activity_detail": {
            "type": "string",
            "maxLength": 128,
            "description": "Optional device-supplied human-readable detail for the current activity, shown next to it. Never parsed by the Server."
          },
          "telemetry_observed_at": {
            "$ref": "#/components/schemas/PeerStatusTelemetryObservedAt"
          },
          "firmware_version": {
            "type": "string",
            "maxLength": 128,
            "description": "Human-readable firmware version the device reports it is running, e.g. \"1.4.2\". Reported over telemetry alongside the digest; the digest identifies the exact package, this names the release. Never parsed by the Server."
          },
          "firmware_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Lowercase SHA-256 digest of the .tar.zlib package the device is currently running, as reported by the device."
          },
          "ota": {
            "$ref": "#/components/schemas/PeerOtaStatus"
          }
        }
      },
      "PeerStatusTelemetryObservedAt": {
        "type": "object",
        "additionalProperties": false,
        "description": "Per-field observation times for the telemetry-sourced members of PeerStatus. Each member records when the device observed the value now stored in the sibling PeerStatus field, which is what lets an out-of-order or replayed report be rejected without overwriting a newer observation. A member is absent until that field has been observed at least once.",
        "properties": {
          "battery_percent": {"type": "string", "format": "date-time"},
          "charging": {"type": "string", "format": "date-time"},
          "gnss_latitude": {"type": "string", "format": "date-time"},
          "gnss_longitude": {"type": "string", "format": "date-time"},
          "gnss_altitude_m": {"type": "string", "format": "date-time"},
          "gnss_accuracy_m": {"type": "string", "format": "date-time"},
          "network_imei": {"type": "string", "format": "date-time"},
          "network_imsi": {"type": "string", "format": "date-time"},
          "activity": {"type": "string", "format": "date-time"},
          "firmware_version": {"type": "string", "format": "date-time"}
        }
      },
      "PeerOtaStatus": {
        "type": "object",
        "additionalProperties": false,
        "description": "Latest device-reported OTA attempt snapshot, retained across disconnects.",
        "required": [
          "state",
          "update_id",
          "observed_at"
        ],
        "properties": {
          "state": {
            "type": "string",
            "description": "Device-reported OTA state: started, downloading, succeeded, or failed. Readers must preserve unknown future values."
          },
          "update_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "download_percent": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 100
          },
          "target_version": {
            "type": "string",
            "maxLength": 128
          },
          "error_code": {
            "type": "string",
            "maxLength": 128
          },
          "error_message": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    }
  }
}
