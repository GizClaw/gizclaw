{
  "openapi": "3.0.3",
  "info": {
    "title": "Credential Spec Type",
    "description": "CredentialSpec schema.",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "CredentialSpec": {
        "type": "object",
        "required": [
          "provider"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "example": "primary openai credential"
          },
          "body": {
            "description": "Write-only provider credential payload. Read responses omit this field; reapplying an omitted body retains the stored secret.",
            "writeOnly": true,
            "allOf": [
              {
                "$ref": "./credential_body.json#/components/schemas/CredentialBody"
              }
            ]
          }
        }
      }
    }
  }
}
