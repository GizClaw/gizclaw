{
  "openapi": "3.0.3",
  "info": {
    "title": "Memory Layout Type",
    "description": "Portable provider-specific long-term-memory policy.",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "MemoryLayout": {
        "type": "object",
        "required": [
          "id",
          "spec"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "spec": {
            "$ref": "#/components/schemas/MemoryLayoutSpec"
          }
        }
      },
      "MemoryLayoutSpec": {
        "type": "object",
        "required": [
          "mem0",
          "volc_mem0"
        ],
        "additionalProperties": false,
        "properties": {
          "mem0": {
            "$ref": "#/components/schemas/Mem0MemoryLayoutPolicy"
          },
          "mem0_self_hosted": {
            "$ref": "#/components/schemas/Mem0SelfHostedMemoryLayoutPolicy"
          },
          "volc_mem0": {
            "$ref": "#/components/schemas/VolcMem0MemoryLayoutPolicy"
          }
        }
      },
      "Mem0MemoryLayoutPolicy": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "workspace",
              "peer"
            ],
            "default": "workspace",
            "description": "Maps Scope.AppID to the Workspace ID or the owner Peer identity (Mem0 app_id)."
          },
          "custom_instructions": {
            "type": "string"
          },
          "custom_categories": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "multilingual": {
            "type": "boolean"
          },
          "decay": {
            "type": "boolean"
          }
        }
      },
      "Mem0SelfHostedMemoryLayoutPolicy": {
        "type": "object",
        "additionalProperties": false,
        "description": "Mem0 OSS extraction policy, selected only by a mem0_self_hosted connection. Model and pgvector configuration belong to the self-hosted service.",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "workspace",
              "peer"
            ],
            "default": "workspace",
            "description": "Maps Scope.AppID to the Workspace ID or owner Peer identity, encoded with the complete logical scope into native user_id."
          },
          "custom_instructions": {
            "type": "string",
            "description": "Instructions passed to the self-hosted service for memory extraction."
          }
        }
      },
      "VolcMem0MemoryLayoutPolicy": {
        "type": "object",
        "required": [
          "strategies"
        ],
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "workspace",
              "peer"
            ],
            "default": "workspace",
            "description": "Maps Scope.AppID to the Workspace ID or the owner Peer identity (Volc Mem0 app_id)."
          },
          "strategies": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/VolcMem0Strategy"
            }
          }
        }
      },
      "VolcMem0Strategy": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "type": {
            "type": "string",
            "enum": [
              "summary",
              "semantic",
              "user_preference"
            ]
          },
          "custom_instructions": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    }
  }
}
