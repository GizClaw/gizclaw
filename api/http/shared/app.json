{
  "openapi": "3.0.3",
  "info": {
    "title": "App",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "App": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "package": {
            "$ref": "./firmware_package.json#/components/schemas/FirmwarePackage"
          },
          "app_name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"
          },
          "runtime": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
          },
          "entry": {
            "type": "string"
          },
          "methods": {
            "type": "array",
            "items": {
              "$ref": "./app_manifest.json#/components/schemas/AppMethod"
            }
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "package",
          "app_name",
          "runtime",
          "entry",
          "methods",
          "sha256",
          "created_at",
          "updated_at"
        ]
      }
    }
  }
}
