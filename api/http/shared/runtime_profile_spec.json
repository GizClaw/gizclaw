{
  "openapi": "3.0.3",
  "info": {
    "title": "RuntimeProfile Spec Schema",
    "description": "RuntimeProfile alias bindings.",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "RuntimeProfileI18nText": {
        "type": "object",
        "required": [
          "display_name"
        ],
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        }
      },
      "RuntimeProfileBinding": {
        "type": "object",
        "required": [
          "resource_id",
          "i18n"
        ],
        "additionalProperties": false,
        "properties": {
          "resource_id": {
            "type": "string",
            "minLength": 1
          },
          "i18n": {
            "type": "object",
            "required": [
              "en",
              "zh-CN"
            ],
            "additionalProperties": {
              "$ref": "#/components/schemas/RuntimeProfileI18nText"
            }
          },
          "tags": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "uniqueItems": true,
            "description": "Only valid for Workflow bindings; opaque strings."
          },
          "sort_order": {
            "type": "integer",
            "format": "int32",
            "minimum": -2147483648,
            "maximum": 2147483647,
            "description": "Only valid for Workflow bindings. Device RPC and HTTP Workflow lists sort by this value ascending, then by alias. Omitted values use zero; negative values can place a Workflow before unconfigured entries. Does not change Workflow identity or Workspace bindings."
          }
        }
      },
      "RuntimeProfileWorkflows": {
        "type": "object",
        "description": "Workflow bindings keyed by Workflow name. Omitted means the RuntimeProfile binds no Workflows.",
        "x-go-type-skip-optional-pointer": true,
        "additionalProperties": {
          "$ref": "#/components/schemas/RuntimeProfileWorkflowBinding"
        }
      },
      "RuntimeProfileMemoryDriver": {
        "type": "string",
        "enum": [
          "mem0",
          "volc_mem0"
        ]
      },
      "RuntimeProfileMemoryBinding": {
        "type": "object",
        "required": [
          "layout_id",
          "driver",
          "connection"
        ],
        "additionalProperties": false,
        "properties": {
          "layout_id": {
            "type": "string",
            "minLength": 1
          },
          "driver": {
            "$ref": "#/components/schemas/RuntimeProfileMemoryDriver"
          },
          "connection": {
            "$ref": "#/components/schemas/RuntimeProfileMemoryConnection"
          }
        }
      },
      "RuntimeProfileMemoryConnection": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/RuntimeProfileMem0Connection"
          },
          {
            "$ref": "#/components/schemas/RuntimeProfileMem0SelfHostedConnection"
          },
          {
            "$ref": "#/components/schemas/RuntimeProfileVolcMem0Connection"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "mem0": "#/components/schemas/RuntimeProfileMem0Connection",
            "mem0_self_hosted": "#/components/schemas/RuntimeProfileMem0SelfHostedConnection",
            "volc_mem0": "#/components/schemas/RuntimeProfileVolcMem0Connection"
          }
        }
      },
      "RuntimeProfileMem0Connection": {
        "type": "object",
        "required": [
          "type",
          "project_id",
          "endpoint",
          "api_key"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "mem0"
            ]
          },
          "project_id": {
            "type": "string",
            "minLength": 1,
            "description": "Deployment/control-plane identity paired with this API key. Mem0 data-plane requests authenticate with api_key and do not send project_id."
          },
          "endpoint": {
            "type": "string",
            "format": "uri",
            "minLength": 1
          },
          "api_key": {
            "type": "string",
            "minLength": 1
          },
          "poll_interval": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "RuntimeProfileMem0SelfHostedConnection": {
        "type": "object",
        "description": "Mem0 OSS HTTP connection. The Mem0 service owns its database and model configuration.",
        "required": [
          "type",
          "endpoint"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "mem0_self_hosted"
            ]
          },
          "endpoint": {
            "type": "string",
            "format": "uri",
            "minLength": 1
          },
          "api_key": {
            "type": "string",
            "minLength": 1,
            "description": "Optional X-API-Key authentication. Omit for a trusted local service without authentication."
          }
        }
      },
      "RuntimeProfileVolcMem0Connection": {
        "type": "object",
        "required": [
          "type",
          "memory_project_id",
          "endpoint",
          "api_key"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "volc_mem0"
            ]
          },
          "memory_project_id": {
            "type": "string",
            "minLength": 1,
            "description": "Deployment/control-plane identity paired with this data-plane API key. Runtime fact requests authenticate with api_key and do not send memory_project_id."
          },
          "endpoint": {
            "type": "string",
            "format": "uri",
            "minLength": 1
          },
          "api_key": {
            "type": "string",
            "minLength": 1
          },
          "poll_interval": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "RuntimeProfileMCPServer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "endpoint"
        ],
        "description": "Private remote MCP connection. Validation never connects to the endpoint; connection settings and headers are not projected to Peers.",
        "properties": {
          "endpoint": {
            "type": "string",
            "format": "uri",
            "minLength": 1,
            "description": "Absolute HTTP(S) Streamable HTTP endpoint without userinfo or fragment. Query parameters are permitted."
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Private HTTP headers. Names and values must be valid HTTP fields; Host, Accept, Content-Type and every MCP-* header are reserved, case-insensitively."
          },
          "refresh_interval": {
            "type": "string",
            "minLength": 1,
            "default": "5m",
            "description": "Resource snapshot refresh duration, from 1s through 24h inclusive. Omitted uses 5m."
          }
        }
      },
      "RuntimeProfileMCPSelection": {
        "type": "object",
        "additionalProperties": false,
        "description": "Eino-only MCP permissions. Enable resources or explicitly select at least one remote Tool name. Aliases of one canonical Workflow must have identical normalized MCP selections.",
        "properties": {
          "resources": {
            "type": "boolean",
            "default": false,
            "description": "Allow reading this server's resources. Omitted means false."
          },
          "tools": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": "Explicit, unique remote Tool names, each non-blank and 1..128 UTF-8 bytes, enforced by Server normalization. Names are preserved verbatim; no discovery or wildcard expansion grants permissions. Omitted or empty means no Tools."
          }
        }
      },
      "RuntimeProfileResources": {
        "type": "object",
        "description": "Model, Voice, Tool, Memory and private MCP server bindings that Workflows reference by alias. Omitted means the RuntimeProfile binds none of them.",
        "x-go-type-skip-optional-pointer": true,
        "additionalProperties": false,
        "properties": {
          "models": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/RuntimeProfileBinding"
            }
          },
          "voices": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/RuntimeProfileBinding"
            }
          },
          "tools": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/RuntimeProfileToolBinding"
            }
          },
          "memories": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/RuntimeProfileMemoryBinding"
            }
          },
          "mcp_servers": {
            "type": "object",
            "description": "Private MCP servers keyed by ordinary RuntimeProfile aliases, unique across Workflow and resource bindings.",
            "additionalProperties": {
              "$ref": "#/components/schemas/RuntimeProfileMCPServer"
            }
          }
        }
      },
      "RuntimeProfileAppConfig": {
        "type": "object",
        "description": "Opaque device-defined configuration downlink. Keys use the RuntimeProfile alias syntax and values are bounded at 4096 UTF-8 bytes; both are enforced during Server-side normalization because OpenAPI 3.0 has no propertyNames keyword and expresses maxLength in characters. The Server stores and returns every value verbatim and never parses it. Clients read it through server.app_config.list and server.app_config.get and cannot write it. Any registered device bound to this RuntimeProfile can read every entry, so values must not contain credentials, API keys or other secrets.",
        "maxProperties": 64,
        "additionalProperties": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "RuntimeProfileSafetyFences": {
        "type": "object",
        "minProperties": 1,
        "description": "Profile-defined identifiers mapped to independent complete prompts. No prompt inherits another. A selected identifier must exist at reload.",
        "additionalProperties": {
          "$ref": "#/components/schemas/RuntimeProfileSafetyFence"
        }
      },
      "RuntimeProfileSafetyFence": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "additionalProperties": false,
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Optional label shown to callers discovering the available levels."
          }
        }
      },
      "RuntimeProfileMhs": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "v0": {
            "$ref": "./mhs_v0.json#/components/schemas/MhsV0Manifest"
          }
        }
      },
      "RuntimeProfileSpec": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "workflows": {
            "$ref": "#/components/schemas/RuntimeProfileWorkflows"
          },
          "resources": {
            "$ref": "#/components/schemas/RuntimeProfileResources"
          },
          "safety_fences": {
            "$ref": "#/components/schemas/RuntimeProfileSafetyFences"
          },
          "mhs": {
            "$ref": "#/components/schemas/RuntimeProfileMhs"
          },
          "app_config": {
            "$ref": "#/components/schemas/RuntimeProfileAppConfig"
          },
          "quota": {
            "type": "object",
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/RuntimeProfileQuota"
              }
            ],
            "description": "Optional provider-call policy. Omitted or null means unlimited. Only custom uses the external Quota HTTP API."
          }
        }
      },
      "RuntimeProfileQuota": {
        "description": "Provider-call policy variants: unlimited or custom HTTP.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/RuntimeProfileQuotaUnlimited"
          },
          {
            "$ref": "#/components/schemas/RuntimeProfileQuotaCustom"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "unlimited": "#/components/schemas/RuntimeProfileQuotaUnlimited",
            "custom": "#/components/schemas/RuntimeProfileQuotaCustom"
          }
        },
        "type": "object"
      },
      "RuntimeProfileQuotaUnlimited": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "unlimited"
            ]
          }
        }
      },
      "RuntimeProfileQuotaCustom": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "endpoint",
          "api_key"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "custom"
            ]
          },
          "endpoint": {
            "type": "string",
            "format": "uri",
            "minLength": 1,
            "description": "Full HTTP(S) endpoint implementing the Quota Service API."
          },
          "api_key": {
            "type": "string",
            "minLength": 1,
            "description": "Server-only Bearer API key for the quota service."
          }
        }
      },
      "RuntimeProfileWorkflowBinding": {
        "type": "object",
        "required": [
          "resource_id",
          "i18n"
        ],
        "additionalProperties": false,
        "properties": {
          "resource_id": {
            "type": "string",
            "minLength": 1
          },
          "i18n": {
            "type": "object",
            "required": [
              "en",
              "zh-CN"
            ],
            "additionalProperties": {
              "$ref": "#/components/schemas/RuntimeProfileI18nText"
            }
          },
          "tags": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "uniqueItems": true,
            "description": "Only valid for Workflow bindings; opaque strings."
          },
          "toolkit": {
            "$ref": "#/components/schemas/RuntimeProfileToolSelection"
          },
          "mcp": {
            "type": "object",
            "description": "MCP permissions keyed by a server alias declared in resources.mcp_servers. Only Eino Workflows support MCP.",
            "additionalProperties": {
              "$ref": "#/components/schemas/RuntimeProfileMCPSelection"
            }
          },
          "sort_order": {
            "type": "integer",
            "format": "int32",
            "minimum": -2147483648,
            "maximum": 2147483647,
            "description": "Only valid for Workflow bindings. Device RPC and HTTP Workflow lists sort by this value ascending, then by alias. Omitted values use zero; negative values can place a Workflow before unconfigured entries. Does not change Workflow identity or Workspace bindings."
          },
          "ptt_asr_model": {
            "type": "string",
            "nullable": true,
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$",
            "description": "Optional ASR Model alias from this RuntimeProfile resources.models for push-to-talk audio input. Omitted or null falls back to realtime_asr_model while retaining push-to-talk input mode. AudioDock publishes its transcript independently and sends original audio to an audio-capable Graph or ASR text to a text Graph. When both ASR aliases are omitted or null, Eino accepts text only. Workflow definitions and Workspace parameters cannot override it."
          },
          "realtime_asr_model": {
            "type": "string",
            "nullable": true,
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$",
            "description": "Optional ASR Model alias from this RuntimeProfile resources.models for realtime input. Omitted or null falls back to ptt_asr_model while retaining realtime input mode. Eino consumes the streaming ASR final utterances as text. When both ASR aliases are omitted or null, Eino accepts text only. Doubao Realtime can use native provider audio without an ASR alias. Workflow definitions and Workspace parameters cannot override it."
          }
        }
      },
      "RuntimeProfileToolSelection": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "verification_model": {
            "type": "string",
            "minLength": 1,
            "description": "Optional Profile llm-model alias for independent semantic checks before mutating Eino Tool calls and before publishing final replies. Rejected replies allow at most two native-model corrections; accepted replies are buffered until checked. Each check adds a model request. This does not grant Tool authority or replace the primary model's native ToolCall."
          },
          "tool_names": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Profile Tool aliases explicitly injected into this Workflow; omitted or empty means no Tools."
          }
        }
      },
      "RuntimeProfileToolBinding": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "i18n"
        ],
        "description": "Select exactly one source. Devices are always the current Peer; HTTP invoke_name and credentials are private implementation details.",
        "properties": {
          "resource_id": {
            "type": "string",
            "minLength": 1,
            "x-go-type-skip-optional-pointer": true
          },
          "mhs": {
            "$ref": "#/components/schemas/RuntimeProfileMhsTool"
          },
          "client_tool": {
            "$ref": "#/components/schemas/RuntimeProfileClientTool"
          },
          "i18n": {
            "type": "object",
            "required": [
              "en",
              "zh-CN"
            ],
            "additionalProperties": {
              "$ref": "#/components/schemas/RuntimeProfileI18nText"
            }
          }
        }
      },
      "RuntimeProfileMhsTool": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "operation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "operation": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ]
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Required for write; every field must be explicitly supported by the device. Forbidden for read."
          }
        }
      },
      "RuntimeProfileClientTool": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "One predefined ClientTool v0 procedure name; model arguments cannot change it."
          }
        }
      }
    }
  }
}
