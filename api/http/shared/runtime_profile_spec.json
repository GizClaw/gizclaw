{
  "openapi": "3.0.3",
  "info": {
    "title": "RuntimeProfile Spec Schema",
    "description": "RuntimeProfile alias bindings.",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "RuntimeProfileI18nText": {
        "type": "object",
        "required": ["display_name"],
        "additionalProperties": false,
        "properties": {
          "display_name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      },
      "RuntimeProfileBinding": {
        "type": "object",
        "required": ["resource_id", "i18n"],
        "additionalProperties": false,
        "properties": {
          "resource_id": { "type": "string", "minLength": 1 },
          "i18n": {
            "type": "object",
            "required": ["en", "zh-CN"],
            "additionalProperties": {
              "$ref": "#/components/schemas/RuntimeProfileI18nText"
            }
          }
        }
      },
      "RuntimeProfileWorkflowCollections": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/components/schemas/RuntimeProfileBinding"
          }
        }
      },
      "RuntimeProfileWorkflows": {
        "type": "object",
        "required": ["collections"],
        "additionalProperties": false,
        "properties": {
          "collections": {
            "$ref": "#/components/schemas/RuntimeProfileWorkflowCollections"
          }
        }
      },
      "RuntimeProfileMemoryDriver": {
        "type": "string",
        "enum": ["flowcraft", "mem0", "volc_mem0"]
      },
      "RuntimeProfileMemoryBinding": {
        "type": "object",
        "required": ["layout_id", "driver", "connection"],
        "additionalProperties": false,
        "properties": {
          "layout_id": {
            "type": "string",
            "minLength": 1
          },
          "driver": {
            "$ref": "#/components/schemas/RuntimeProfileMemoryDriver"
          },
          "connection": {
            "$ref": "#/components/schemas/RuntimeProfileMemoryConnection"
          }
        }
      },
      "RuntimeProfileMemoryConnection": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/RuntimeProfileFlowcraftBBHConnection"
          },
          {
            "$ref": "#/components/schemas/RuntimeProfileFlowcraftObjectStoreConnection"
          },
          {
            "$ref": "#/components/schemas/RuntimeProfileFlowcraftPostgreSQLConnection"
          },
          {
            "$ref": "#/components/schemas/RuntimeProfileFlowcraftRedis8Connection"
          },
          {
            "$ref": "#/components/schemas/RuntimeProfileMem0Connection"
          },
          {
            "$ref": "#/components/schemas/RuntimeProfileVolcMem0Connection"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "flowcraft_bbh": "#/components/schemas/RuntimeProfileFlowcraftBBHConnection",
            "flowcraft_object_store": "#/components/schemas/RuntimeProfileFlowcraftObjectStoreConnection",
            "flowcraft_postgresql": "#/components/schemas/RuntimeProfileFlowcraftPostgreSQLConnection",
            "flowcraft_redis8": "#/components/schemas/RuntimeProfileFlowcraftRedis8Connection",
            "mem0": "#/components/schemas/RuntimeProfileMem0Connection",
            "volc_mem0": "#/components/schemas/RuntimeProfileVolcMem0Connection"
          }
        }
      },
      "RuntimeProfileFlowcraftBBHConnection": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["flowcraft_bbh"]
          }
        }
      },
      "RuntimeProfileFlowcraftObjectStoreConnection": {
        "type": "object",
        "required": ["type", "directory"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["flowcraft_object_store"]
          },
          "directory": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "RuntimeProfileFlowcraftPostgreSQLConnection": {
        "type": "object",
        "required": ["type", "dsn"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["flowcraft_postgresql"]
          },
          "dsn": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "RuntimeProfileFlowcraftRedis8Connection": {
        "type": "object",
        "required": ["type", "url"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["flowcraft_redis8"]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "minLength": 1
          },
          "tls_ca_file": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "RuntimeProfileMem0Connection": {
        "type": "object",
        "required": ["type", "project_id", "endpoint", "api_key"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["mem0"]
          },
          "project_id": {
            "type": "string",
            "minLength": 1,
            "description": "Deployment/control-plane identity paired with this API key. Mem0 data-plane requests authenticate with api_key and do not send project_id."
          },
          "endpoint": {
            "type": "string",
            "format": "uri",
            "minLength": 1
          },
          "api_key": {
            "type": "string",
            "minLength": 1
          },
          "poll_interval": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "RuntimeProfileVolcMem0Connection": {
        "type": "object",
        "required": ["type", "memory_project_id", "endpoint", "api_key"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["volc_mem0"]
          },
          "memory_project_id": {
            "type": "string",
            "minLength": 1,
            "description": "Deployment/control-plane identity paired with this data-plane API key. Runtime fact requests authenticate with api_key and do not send memory_project_id."
          },
          "endpoint": {
            "type": "string",
            "format": "uri",
            "minLength": 1
          },
          "api_key": {
            "type": "string",
            "minLength": 1
          },
          "poll_interval": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "RuntimeProfileResources": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "models": {
            "type": "object",
            "additionalProperties": { "$ref": "#/components/schemas/RuntimeProfileBinding" }
          },
          "voices": {
            "type": "object",
            "additionalProperties": { "$ref": "#/components/schemas/RuntimeProfileBinding" }
          },
          "tools": {
            "type": "object",
            "additionalProperties": { "$ref": "#/components/schemas/RuntimeProfileBinding" }
          },
          "memories": {
            "type": "object",
            "additionalProperties": { "$ref": "#/components/schemas/RuntimeProfileMemoryBinding" }
          }
        }
      },
      "RuntimeProfileSpec": {
        "type": "object",
        "required": ["workflows", "resources"],
        "additionalProperties": false,
        "properties": {
          "workflows": { "$ref": "#/components/schemas/RuntimeProfileWorkflows" },
          "resources": { "$ref": "#/components/schemas/RuntimeProfileResources" }
        }
      }
    }
  }
}
