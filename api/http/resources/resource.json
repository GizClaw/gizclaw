{
  "openapi": "3.0.3",
  "info": {
    "title": "GizClaw Resource Types",
    "description": "Declarative resource envelope schemas used by admin apply.",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "ResourceAPIVersion": {
        "type": "string",
        "description": "API version for declarative GizClaw resources.",
        "enum": [
          "gizclaw.admin/v1alpha1"
        ]
      },
      "ResourceKind": {
        "type": "string",
        "description": "Declarative GizClaw resource kind.",
        "enum": [
          "Credential",
          "Firmware",
          "Contact",
          "Friend",
          "FriendGroup",
          "FriendGroupInviteToken",
          "FriendGroupMember",
          "Model",
          "DashScopeTenant",
          "DeepSeekTenant",
          "GeminiTenant",
          "MiniMaxTenant",
          "OpenAITenant",
          "VolcTenant",
          "Voice",
          "Tool",
          "Workflow",
          "Workspace",
          "PetDef",
          "BadgeDef",
          "GameDef",
          "MemoryLayout",
          "RuntimeProfile",
          "RegistrationToken",
          "ResourceList"
        ]
      },
      "ResourceMetadata": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
	        "description": "Immutable opaque canonical ID supplied by the caller and persisted exactly as submitted, with a maximum length of 1024 Unicode characters. Leading or trailing whitespace and the standalone URI dot segments . and .. are invalid.",
	        "minLength": 1,
	        "maxLength": 1024,
	        "pattern": "^(?:[^\\s.]|[^\\s.][\\s\\S]*[^\\s]|\\.[^\\s.](?:[\\s\\S]*[^\\s])?|\\.\\.[\\s\\S]*[^\\s])$"
          },
          "annotations": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "owner_public_key": {
            "type": "string",
            "description": "Immutable owner Public Key for Client-created resources. Admin-owned resources omit this field."
          }
        }
      },
      "Resource": {
        "oneOf": [
          {
            "$ref": "./credential.json#/components/schemas/CredentialResource"
          },
          {
            "$ref": "./firmware.json#/components/schemas/FirmwareResource"
          },
          {
            "$ref": "./contact.json#/components/schemas/ContactResource"
          },
          {
            "$ref": "./friend.json#/components/schemas/FriendResource"
          },
          {
