{
  "openapi": "3.0.3",
  "info": {
    "title": "RegistrationToken Resource Schema",
    "description": "RegistrationToken declarative resource envelope.",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "RegistrationTokenResource": {
        "type": "object",
        "required": [
          "apiVersion",
          "kind",
          "metadata",
          "spec"
        ],
        "properties": {
          "apiVersion": {
            "$ref": "./resource.json#/components/schemas/ResourceAPIVersion"
          },
          "kind": {
            "type": "string",
            "enum": [
              "RegistrationToken"
            ]
          },
          "metadata": {
            "$ref": "./resource.json#/components/schemas/ResourceMetadata"
          },
          "spec": {
            "type": "object",
            "required": [
              "token",
              "runtime_profile_id"
            ],
            "additionalProperties": false,
            "properties": {
              "token": {
                "type": "string",
                "maxLength": 512,
                "description": "Registration token, at most 512 UTF-8 bytes. The Server enforces the byte limit in addition to this character bound."
              },
              "runtime_profile_id": {
                "type": "string"
              },
              "firmware_id": {
                "type": "string",
                "description": "Optional caller-defined Firmware ID. The device selects its own channel."
              },
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "Whether this token permits new device activations. Defaults to true."
              },
              "expires_at": {
                "type": "string",
                "format": "date-time",
                "nullable": true,
                "description": "Exclusive expiration time. Null or omitted means no expiration."
              },
              "max_activations": {
                "type": "integer",
                "format": "int64",
                "minimum": 0,
                "nullable": true,
                "description": "Maximum distinct public keys activated by this token. Null or omitted means unlimited; lowering below the current count prevents new activations."
              }
            }
          }
        }
      }
    }
  }
}
