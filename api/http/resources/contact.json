{
  "openapi": "3.0.3",
  "info": {
    "title": "Contact Resource Schema",
    "description": "ContactResource envelope schema.",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "ContactResource": {
        "type": "object",
        "required": [
          "apiVersion",
          "kind",
          "metadata",
          "spec"
        ],
        "properties": {
          "apiVersion": {
            "$ref": "./resource.json#/components/schemas/ResourceAPIVersion"
          },
          "kind": {
            "type": "string",
            "enum": [
              "Contact"
            ]
          },
          "metadata": {
            "allOf": [
              {
                "$ref": "./resource.json#/components/schemas/ResourceMetadata"
              }
            ],
            "description": "metadata.id is the caller-supplied canonical Contact ID. spec.name is the immutable owner-scoped Peer-visible contact name."
          },
          "spec": {
            "$ref": "#/components/schemas/ContactSpec"
          }
        }
      },
      "ContactSpec": {
        "type": "object",
        "required": [
          "owner_public_key",
          "name"
        ],
        "properties": {
          "owner_public_key": {
            "type": "string",
            "minLength": 1,
            "description": "Immutable owner peer public key."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Immutable owner-scoped Peer-visible contact name."
          },
          "display_name": {
            "type": "string"
          },
          "phone_number": {
            "type": "string"
          }
        }
      }
    }
  }
}
