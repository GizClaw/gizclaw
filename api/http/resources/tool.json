{
  "openapi": "3.0.3",
  "info": {
    "title": "Tool Resource Schema",
    "description": "ToolResource envelope schema.",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "ToolResource": {
        "type": "object",
        "required": [
          "apiVersion",
          "kind",
          "metadata",
          "spec"
        ],
        "properties": {
          "apiVersion": {
            "$ref": "./resource.json#/components/schemas/ResourceAPIVersion"
          },
          "kind": {
            "type": "string",
            "enum": [
              "Tool"
            ]
          },
          "metadata": {
            "allOf": [
              {
                "$ref": "./resource.json#/components/schemas/ResourceMetadata"
              }
            ],
            "description": "metadata.id is the canonical Tool resource ID when updating. metadata.name is the immutable runtime execution name and must match ^[A-Za-z_][A-Za-z0-9_-]{0,63}$."
          },
          "spec": {
            "$ref": "../shared/tool_spec.json#/components/schemas/ToolSpec"
          }
        }
      }
    }
  }
}
