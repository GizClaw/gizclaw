{
  "openapi": "3.0.3",
  "info": {
    "title": "Node Monitor",
    "version": "1.0.0",
    "description": "Local node monitoring, authenticated with an independent Monitor Token. No peer token grants node access."
  },
  "paths": {
    "/monitor/api/node": {
      "get": {
        "operationId": "getNodeMonitor",
        "security": [
          {
            "MonitorToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Process-local runtime, device and transport snapshot; no business storage or metrics backend query.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeSnapshot"
                }
              }
            }
          },
          "401": {
            "description": "Invalid monitor token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonitorError"
                }
              }
            }
          },
          "503": {
            "description": "Node monitoring disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonitorError"
                }
              }
            }
          },
          "405": {
            "description": "Unsupported method; empty body and Allow: GET"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "MonitorToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "gizclaw_mk_<random token>"
      }
    },
    "schemas": {
      "NodeSnapshot": {
        "type": "object",
        "required": [
          "public_key",
          "role",
          "version",
          "build_commit",
          "time",
          "uptime_seconds",
          "goroutines",
          "heap_bytes",
          "transport"
        ],
        "properties": {
          "public_key": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "description": "Software version embedded in this process binary; \"dev\" for unversioned builds."
          },
          "build_commit": {
            "type": "string",
            "description": "Source commit embedded in this process binary; \"dev\" for unversioned builds."
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "uptime_seconds": {
            "type": "number",
            "format": "double"
          },
          "goroutines": {
            "type": "integer"
          },
          "heap_bytes": {
            "type": "integer",
            "format": "uint64"
          },
          "transport": {
            "type": "object",
            "required": [
              "connections",
              "services",
              "inbound_service_channels",
              "rx_bytes",
              "tx_bytes"
            ],
            "properties": {
              "connections": {
                "type": "integer",
                "minimum": 0
              },
              "services": {
                "type": "integer",
                "minimum": 0
              },
              "rx_bytes": {
                "type": "integer",
                "minimum": 0,
                "format": "uint64"
              },
              "tx_bytes": {
                "type": "integer",
                "minimum": 0,
                "format": "uint64"
              },
              "inbound_service_channels": {
                "type": "integer",
                "minimum": 0,
                "description": "Current remote-opened service DataChannels admitted across this process, including pending opens. Released on stream or parent connection close. Excludes locally opened, packet, and native tunnel channels."
              }
            }
          },
          "device_metrics": {
            "$ref": "#/components/schemas/NodeDeviceMetrics"
          },
          "infra_flows": {
            "$ref": "#/components/schemas/NodeInfraFlows"
          }
        }
      },
      "MonitorError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "INVALID_MONITOR_TOKEN",
              "MONITOR_DISABLED"
            ]
          }
        }
      },
      "MonitorDirections": {
        "type": "object",
        "required": [
          "rx",
          "tx"
        ],
        "properties": {
          "rx": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "tx": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        }
      },
      "MonitorDataChannels": {
        "type": "object",
        "required": [
          "packet",
          "service",
          "native"
        ],
        "properties": {
          "packet": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "service": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "native": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        }
      },
      "NodePeerTransport": {
        "type": "object",
        "required": [
          "peer_kind",
          "rtp_tracks",
          "data_channels",
          "rtp_packets_total",
          "data_channel_messages_total"
        ],
        "properties": {
          "peer_kind": {
            "type": "string",
            "enum": [
              "device",
              "upstream",
              "admin",
              "unknown"
            ]
          },
          "rtp_tracks": {
            "$ref": "#/components/schemas/MonitorDirections"
          },
          "data_channels": {
            "$ref": "#/components/schemas/MonitorDataChannels"
          },
          "rtp_packets_total": {
            "$ref": "#/components/schemas/MonitorDirections"
          },
          "data_channel_messages_total": {
            "$ref": "#/components/schemas/MonitorDirections"
          }
        }
      },
      "NodeDeviceMetrics": {
        "type": "object",
        "description": "Live in-memory device and physical transport counters. Absent on older nodes. Server and Edge online counts are different views and must not be added together.",
        "required": [
          "transports"
        ],
        "properties": {
          "online_devices": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0,
            "description": "Distinct active device identities; omitted when the embedding host has no device count source."
          },
          "transports": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "$ref": "#/components/schemas/NodePeerTransport"
            }
          }
        }
      },
      "NodeInfraFlows": {
        "type": "object",
        "description": "Opt-in completed five-second infrastructure route counters owned by this Server. No device/session dimensions; absent when disabled or the window is incomplete. Generation changes on restart.",
        "required": [
          "environment",
          "generation",
          "flows",
          "window_start",
          "window_end"
        ],
        "additionalProperties": false,
        "properties": {
          "environment": {
            "type": "string",
            "enum": [
              "dev",
              "e2e",
              "prod",
              "trial"
            ]
          },
          "generation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "flows": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "./infra.json#/components/schemas/Flow"
            }
          },
          "window_start": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "window_end": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      }
    }
  }
}
