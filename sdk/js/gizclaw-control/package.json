{
  "name": "@gizclaw/gizclaw-control",
  "version": "0.1.2",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GizClaw/gizclaw.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=23.5.0"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "scripts": {
    "prebuild": "npm run build --prefix ../gizclaw",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../scripts/prepare-published-sdk.mjs gizclaw-control",
    "prepack": "npm run build",
    "pretest": "npm run build --prefix ../gizclaw",
    "test": "node --test --experimental-strip-types *.test.ts"
  },
  "dependencies": {
    "@gizclaw/gizclaw": "^0.13.0"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "typescript": "6.0.3"
  }
}
